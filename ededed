<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>GALACTIC Launcher</title>
    
    <!-- Подключение шрифтов Google -->
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Подключение наших стилей -->
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <!-- Кастомный курсор -->
    <div class="cursor" id="cursor"></div>
    
    <!-- Фоновые звезды (для ползунка графики) -->
    <div class="stars-bg" id="starsBg"></div>
    
    <!-- Canvas для отрисовки галактики (рисуется через galaxy.js) -->
    <canvas class="galaxy-canvas" id="galaxyCanvas"></canvas>

    <!-- Логотип -->
    <div class="logo">GALACTIC</div>

    <!-- ВЫЕЗЖАЮЩЕЕ МЕНЮ (Настройки) -->
    <div class="side-menu" id="sideMenu">
        <div class="close-menu interactive" id="closeMenuBtn">
            <svg viewBox="0 0 24 24"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg>
        </div>
        
        <div class="menu-title">Settings</div>
        
        <!-- Слайдер ОЗУ -->
        <div class="settings-group">
            <label>Выделение ОЗУ (RAM)</label>
            <div class="ram-slider interactive" id="ramSlider">
                <div class="ram-fill" id="ramFill"></div>
                <div class="ram-thumb" id="ramThumb"></div>
            </div>
            <div class="ram-value" id="ramValue">4 GB</div>
        </div>

        <!-- Кнопки папок -->
        <div class="settings-group">
            <label>Папки игры</label>
            <div class="folder-btn interactive">
                <svg viewBox="0 0 24 24"><path d="M20 6h-8l-2-2H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm0 12H4V8h16v10z"/></svg>
                Открыть .minecraft
            </div>
            <div class="folder-btn interactive">
                <svg viewBox="0 0 24 24"><path d="M20 6h-8l-2-2H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm0 12H4V8h16v10z"/></svg>
                Открыть папку mods
            </div>
        </div>
    </div>

    <!-- ВЕРХНЯЯ ПАНЕЛЬ (Профиль и Соцсети) -->
    <div class="ui-layer">
        <div class="top-bar">
            <div class="top-left">
                <div class="menu-btn ui-panel interactive" id="menuBtn">
                    <svg viewBox="0 0 24 24"><path d="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z"/></svg>
                </div>
                <div class="profile-card ui-panel interactive">
                    <div class="avatar"></div>
                    <div class="user-info">
                        <div class="username">User</div>
                        <div class="version">1.20.4</div>
                    </div>
                </div>
            </div>
            
            <div class="nav-actions">
                <div class="icon-btn ui-panel interactive">
                    <svg viewBox="0 0 24 24"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z"/></svg>
                </div>
                <div class="icon-btn ui-panel interactive">
                    <svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69.01-.03.01-.14-.07-.19-.08-.05-.19-.02-.27 0-.11.03-1.84 1.17-5.19 3.44-.49.34-.94.5-1.34.49-.44-.01-1.29-.25-1.92-.46-.78-.26-1.4-.4-1.35-.85.02-.23.35-.47.98-.72 3.85-1.68 6.42-2.78 7.71-3.32 3.66-1.52 4.42-1.79 4.91-1.8.11 0 .35.03.5.13.13.09.17.21.18.3.01.09.02.27.01.36z"/></svg>
                </div>
            </div>
        </div>
    </div>

    <!-- КНОПКА PLAY -->
    <div class="center-play">
        <button class="btn-play interactive">PLAY</button>
        <button class="btn-version interactive">Select Version</button>
    </div>

    <!-- НИЖНИЙ ПОЛЗУНОК ГРАФИКИ -->
    <div class="bottom-bar">
        <div class="slider-wrapper ui-panel">
            <div class="slider-label">Graphics</div>
            <div class="slider-track interactive" id="track">
                <div class="slider-fill" id="fill"></div>
                <div class="slider-thumb" id="thumb"></div>
                <div class="slider-text" id="slider-text">Medium</div>
            </div>
        </div>
    </div>

    <!-- ПАЛИТРА ЦВЕТОВ (Кнопка и выпадающее окно) -->
    <div class="palette-btn ui-panel interactive" id="paletteBtn">
        <svg viewBox="0 0 24 24"><path d="M12 3c-4.97 0-9 4.03-9 9s4.03 9 9 9c.83 0 1.5-.67 1.5-1.5 0-.39-.15-.74-.39-1.01-.23-.26-.38-.61-.38-.99 0-.83.67-1.5 1.5-1.5H16c2.76 0 5-2.24 5-5 0-4.42-4.03-8-9-8zm-5.5 9c-.83 0-1.5-.67-1.5-1.5S5.67 9 6.5 9 8 9.67 8 10.5 7.33 12 6.5 12zm3-4C8.67 8 8 7.33 8 6.5S8.67 5 9.5 5s1.5.67 1.5 1.5S10.33 8 9.5 8zm5 0c-.83 0-1.5-.67-1.5-1.5S13.67 5 14.5 5s1.5.67 1.5 1.5S15.33 8 14.5 8zm3 4c-.83 0-1.5-.67-1.5-1.5S16.67 9 17.5 9s1.5.67 1.5 1.5-.67 1.5-1.5 1.5z"/></svg>
    </div>

    <div class="color-picker-popup ui-panel" id="colorPopup">
        <div class="color-wheel interactive" id="colorWheel">
            <div class="wheel-picker" id="wheelPicker"></div>
        </div>
    </div>

    <!-- ========================================== -->
    <!-- ПОДКЛЮЧЕНИЕ СКРИПТОВ (Порядок очень важен!) -->
    <!-- ========================================== -->
    <script src="galaxy.js"></script>
    <script src="script.js"></script>
    <script src="palette.js"></script>
</body>
</html>
