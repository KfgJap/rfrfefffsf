    </div>

    <div class="center">
        <button class="play-btn">
            <svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
            Играть
        </button>
        <div class="version glass-panel">Выбрать версию</div>
    </div>

