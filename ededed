<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <title>Nebula Launcher</title>
    <link rel="stylesheet" href="style.css">
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>
    <!-- СЛОИ ФОНА (Галактика и Звезды) -->
    <div class="bg-layer">
        <div class="galaxy"></div>
        <div class="stars"></div>
        <div class="nebula"></div>
    </div>

    <!-- КУРСОР -->
    <div class="cursor" id="cursor"></div>

    <!-- ПРОФИЛЬ (Слева сверху) -->
    <div class="profile glass">
        <div class="avatar"></div>
        <div class="nickname">Мик версия</div>
    </div>

    <!-- НАСТРОЙКИ (Справа сверху) -->
    <div class="top-actions">
        <button class="icon-btn glass">
            <svg viewBox="0 0 24 24"><path d="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.06-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61 l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41 h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.73,8.87 C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.06,0.94l-2.03,1.58 c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54 c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96 c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.49-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6 s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z"/></svg>
        </button>
        <button class="icon-btn glass">
            <svg viewBox="0 0 24 24"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg>
        </button>
    </div>

    <!-- ЦЕНТР: Кнопки -->
    <div class="center-menu">
        <button class="play-btn">Играть</button>
        <button class="version-btn">Выбрать версию</button>
    </div>

    <!-- НИЗ: Ползунок -->
    <div class="slider-container glass">
        <span class="slider-label">Графика</span>
        <div class="slider-track" id="sliderTrack">
            <div class="slider-fill" id="sliderFill"></div>
            <div class="slider-thumb" id="sliderThumb"></div>
        </div>
        <div class="slider-marks">
            <span class="mark" id="mark0">Слабо</span>
            <span class="mark active" id="mark1">Средне</span>
            <span class="mark" id="mark2">Мощно</span>
        </div>
    </div>

    <!-- ПАЛИТРА: Кнопка вызова -->
    <button class="palette-btn glass" id="paletteBtn">
        <svg viewBox="0 0 24 24"><path d="M12 3c-4.97 0-9 4.03-9 9s4.03 9 9 9c.83 0 1.5-.67 1.5-1.5 0-.39-.15-.74-.39-1.01-.23-.26-.38-.61-.38-.99 0-.83.67-1.5 1.5-1.5H16c2.76 0 5-2.24 5-5 0-4.42-4.03-8-9-8zm-5.5 9c-.83 0-1.5-.67-1.5-1.5S5.67 9 6.5 9 8 9.67 8 10.5 7.33 12 6.5 12zm3-4C8.67 8 8 7.33 8 6.5S8.67 5 9.5 5s1.5.67 1.5 1.5S10.33 8 9.5 8zm5 0c-.83 0-1.5-.67-1.5-1.5S13.67 5 14.5 5s1.5.67 1.5 1.5S15.33 8 14.5 8zm3 4c-.83 0-1.5-.67-1.5-1.5S16.67 9 17.5 9s1.5.67 1.5 1.5-.67 1.5-1.5 1.5z"/></svg>
    </button>

    <!-- ПАЛИТРА: Окно -->
    <div class="palette-menu glass" id="paletteMenu">
        <div class="color-wheel-wrap">
            <div class="color-wheel" id="colorWheel">
                <div class="wheel-picker" id="wheelPicker"></div>
            </div>
        </div>
        <div class="hex-wrap">
            <label>HEX Код</label>
            <input type="text" id="hexInput" value="#5E9EFF" maxlength="7">
        </div>
    </div>

    <script>
        // КУРСОР
        const cursor = document.getElementById('cursor');
        document.addEventListener('mousemove', (e) => {
            cursor.style.left = e.clientX + 'px';
            cursor.style.top = e.clientY + 'px';
        });
        document.querySelectorAll('button, .profile, .palette-btn').forEach(el => {
            el.addEventListener('mouseenter', () => cursor.style.transform = 'translate(-50%, -50%) scale(2.5)');
            el.addEventListener('mouseleave', () => cursor.style.transform = 'translate(-50%, -50%) scale(1)');
        });

        // ПАЛИТРА (Открытие)
        const paletteBtn = document.getElementById('paletteBtn');
        const paletteMenu = document.getElementById('paletteMenu');
        paletteBtn.addEventListener('click', () => {
            paletteMenu.classList.toggle('open');
        });

        // ПАЛИТРА (Цвет)
        const wheel = document.getElementById('colorWheel');
        const picker = document.getElementById('wheelPicker');
        const hexInput = document.getElementById('hexInput');

        function setThemeColor(hex) {
            document.documentElement.style.setProperty('--primary', hex);
            hexInput.value = hex.toUpperCase();
            picker.style.backgroundColor = hex;
        }

        // Выбор цвета ТОЛЬКО по клику
        wheel.addEventListener('click', (e) => {
            let rect = wheel.getBoundingClientRect();
            let x = e.clientX - rect.left - rect.width / 2;
            let y = e.clientY - rect.top - rect.height / 2;
            let angle = Math.atan2(y, x) * (180 / Math.PI) + 90;
            if (angle < 0) angle += 360;
            
            // Перевод угла в HEX
            let hue = angle;
            let hex = hslToHex(hue, 100, 60);
            setThemeColor(hex);
            
            // Двигаем маркер
            let radius = rect.width / 2 - 10;
            picker.style.left = (Math.cos(angle * Math.PI / 180 - Math.PI / 2) * radius + rect.width / 2) + 'px';
            picker.style.top = (Math.sin(angle * Math.PI / 180 - Math.PI / 2) * radius + rect.height / 2) + 'px';
        });

        function hslToHex(h, s, l) {
            l /= 100;
            const a = s * Math.min(l, 1 - l) / 100;
            const f = n => {
                const k = (n + h / 30) % 12;
                const color = l - a * Math.max(Math.min(k - 3, 9 - k, 1), -1);
                return Math.round(255 * color).toString(16).padStart(2, '0');
            };
            return `#${f(0)}${f(8)}${f(4)}`;
        }

        // ПОЛЗУНОК
        const track = document.getElementById('sliderTrack');
        const fill = document.getElementById('sliderFill');
        const thumb = document.getElementById('sliderThumb');
        let isDragging = false;

        track.addEventListener('mousedown', (e) => {
            isDragging = true;
            updateSlider(e);
        });

        window.addEventListener('mousemove', (e) => {
            if (isDragging) updateSlider(e);
        });

        window.addEventListener('mouseup', () => {
            isDragging = false;
        });

        function updateSlider(e) {
            let rect = track.getBoundingClientRect();
            let x = Math.max(0, Math.min(100, ((e.clientX - rect.left) / rect.width) * 100));
            fill.style.width = x + '%';
            thumb.style.left = x + '%';
        }
    </script>
</body>
</html>
