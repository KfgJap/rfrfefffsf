:root {
    --primary: #5e9eff;
    --bg: #030407;
    --panel: rgba(15, 22, 40, 0.6);
    --border: rgba(255, 255, 255, 0.1);
    --text: #fff;
    --text-dim: #8892b0;
}

* {
    margin: 0; padding: 0; box-sizing: border-box;
    font-family: 'Manrope', sans-serif;
    cursor: none;
}

body {
    height: 100vh;
    background-color: var(--bg);
    color: var(--text);
    overflow: hidden;
}

/* --- ФОН (Галактика и Звезды) --- */
.bg-layer {
    position: absolute; inset: 0; z-index: 0; pointer-events: none; overflow: hidden;
}

.galaxy {
    position: absolute; top: 50%; left: 50%;
    width: 200vw; height: 200vw;
    background: conic-gradient(from 0deg, transparent, rgba(94, 158, 255, 0.15), transparent, rgba(138, 43, 226, 0.1), transparent);
    border-radius: 50%;
    filter: blur(80px);
    transform: translate(-50%, -50%) rotate(0deg);
    animation: spin 120s linear infinite;
}

@keyframes spin { 100% { transform: translate(-50%, -50%) rotate(360deg); } }

.stars {
    position: absolute; inset: -100%;
    background-image: 
        radial-gradient(2px 2px at 20% 30%, #fff, transparent),
        radial-gradient(1px 1px at 70% 60%, #fff, transparent),
        radial-gradient(1.5px 1.5px at 40% 80%, #fff, transparent);
    background-size: 400px 400px;
    opacity: 0.6;
    animation: drift 100s linear infinite;
}

@keyframes drift { 100% { transform: rotate(5deg) translate(50px, 50px); } }

.nebula {
    position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
    width: 80vw; height: 80vh;
    background: radial-gradient(circle, rgba(94, 158, 255, 0.15) 0%, transparent 70%);
    filter: blur(100px);
}

/* --- СТЕКЛО --- */
.glass {
    background: var(--panel);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border: 1px solid var(--border);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
    transition: all 0.4s ease;
}
.glass:hover {
    border-color: rgba(94, 158, 255, 0.4);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.6), 0 0 20px rgba(94, 158, 255, 0.2);
    transform: translateY(-2px);
}

/* --- КУРСОР --- */
.cursor {
    position: fixed;
    width: 6px; height: 6px;
    background: var(--primary);
    border-radius: 50%;
    pointer-events: none;
    z-index: 9999;
    transform: translate(-50%, -50%);
    box-shadow: 0 0 10px var(--primary);
    transition: transform 0.3s ease;
}

/* --- ПРОФИЛЬ --- */
.profile {
    position: absolute; top: 40px; left: 40px;
    display: flex; align-items: center; gap: 15px;
    padding: 10px 25px 10px 10px;
    border-radius: 50px;
    z-index: 10;
}
.avatar {
    width: 40px; height: 40px; border-radius: 50%;
    background: #1e2433; border: 1px solid var(--primary);
}
.nickname { font-weight: 700; font-size: 14px; letter-spacing: 1px; }

/* --- НАСТРОЙКИ --- */
.top-actions {
    position: absolute; top: 40px; right: 40px;
    display: flex; gap: 12px; z-index: 10;
}
.icon-btn {
    width: 44px; height: 44px; border-radius: 14px;
    display: flex; justify-content: center; align-items: center;
    cursor: pointer;
}
.icon-btn svg { width: 20px; height: 20px; fill: var(--text-dim); transition: 0.3s; }
.icon-btn:hover svg { fill: var(--primary); }

/* --- ЦЕНТР --- */
.center-menu {
    position: absolute; top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    display: flex; flex-direction: column; align-items: center; gap: 20px;
    z-index: 10;
}
.play-btn {
    background: linear-gradient(180deg, rgba(94, 158, 255, 0.2), transparent);
    border: 1px solid var(--primary);
    color: #fff; font-size: 24px; font-weight: 800; letter-spacing: 4px;
    padding: 20px 80px; border-radius: 16px;
    cursor: pointer;
    box-shadow: 0 0 30px rgba(94, 158, 255, 0.2);
    transition: 0.4s ease;
}
.play-btn:hover {
    box-shadow: 0 0 50px rgba(94, 158, 255, 0.4);
    background: linear-gradient(180deg, rgba(94, 158, 255, 0.4), transparent);
}
.version-btn {
    background: transparent; border: none; color: var(--text-dim);
    font-weight: 600; font-size: 14px; letter-spacing: 1px; cursor: pointer;
    transition: 0.3s;
}
.version-btn:hover { color: var(--primary); }

/* --- ПОЛЗУНОК --- */
.slider-container {
    position: absolute; bottom: 40px; left: 50%;
    transform: translateX(-50%);
    display: flex; align-items: center; gap: 20px;
    padding: 15px 30px; border-radius: 40px; z-index: 10;
}
.slider-label { font-size: 12px; font-weight: 800; color: var(--text-dim); letter-spacing: 1px; }
.slider-track {
    position: relative; width: 200px; height: 6px;
    background: rgba(255,255,255,0.1); border-radius: 3px;
}
.slider-fill {
    position: absolute; left: 0; top: 0; height: 100%;
    width: 50%; background: var(--primary); border-radius: 3px;
}
.slider-thumb {
    position: absolute; left: 50%; top: 50%;
    transform: translate(-50%, -50%);
    width: 20px; height: 20px; background: #fff; border-radius: 50%;
    cursor: pointer; box-shadow: 0 0 10px var(--primary);
}
.slider-marks { display: flex; gap: 15px; }
.mark { font-size: 11px; font-weight: 700; color: var(--text-dim); }
.mark.active { color: var(--primary); }

/* --- ПАЛИТРА --- */
.palette-btn {
    position: absolute; bottom: 40px; right: 40px;
    width: 54px; height: 54px; border-radius: 16px;
    display: flex; justify-content: center; align-items: center;
    cursor: pointer; z-index: 20;
}
.palette-btn svg { width: 24px; height: 24px; fill: var(--text-dim); }
.palette-btn:hover svg { fill: var(--primary); }

.palette-menu {
    position: absolute; bottom: 110px; right: 40px;
    width: 300px; padding: 20px; border-radius: 20px;
    display: flex; align-items: center; gap: 20px;
    z-index: 20;
    opacity: 0; pointer-events: none;
    transform: translateY(20px) scale(0.95);
    transition: 0.4s ease;
}
.palette-menu.open { opacity: 1; pointer-events: all; transform: translateY(0) scale(1); }

.color-wheel {
    position: relative; width: 80px; height: 80px;
    border-radius: 50%;
    background: conic-gradient(red, yellow, lime, aqua, blue, magenta, red);
    cursor: crosshair;
}
.wheel-picker {
    position: absolute; width: 14px; height: 14px;
    border: 2px solid #fff; border-radius: 50%;
    transform: translate(-50%, -50%); pointer-events: none;
}
.hex-wrap { display: flex; flex-direction: column; gap: 5px; }
.hex-wrap label { font-size: 11px; font-weight: 800; color: var(--text-dim); }
.hex-wrap input {
    width: 100px; padding: 10px; border-radius: 8px;
    border: 1px solid var(--border); background: rgba(0,0,0,0.3);
    color: #fff; font-family: monospace; text-align: center;
}
