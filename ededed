* { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Georgia', serif; }
body { background-color: #000; overflow: hidden; color: white; cursor: crosshair; }

canvas { display: block; width: 100vw; height: 100vh; position: absolute; top: 0; left: 0; z-index: 1; }

/* --- ЭКРАН ВСТУПЛЕНИЯ --- */
#introScreen {
    position: absolute; inset: 0; z-index: 10;
    background: #000;
    display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 20px;
    transition: opacity 2s ease;
}

.intro-text {
    font-size: 24px; font-style: italic; color: #8892b0;
    opacity: 0; animation: fadeIn 3s forwards;
}
.intro-text:nth-child(1) { animation-delay: 1s; }
.intro-text:nth-child(2) { animation-delay: 4s; }
.intro-text:nth-child(3) { animation-delay: 7s; }
.intro-text:nth-child(4) { animation-delay: 10s; }

@keyframes fadeIn { to { opacity: 1; } }

.btn {
    margin-top: 40px; padding: 15px 40px;
    background: transparent; border: 1px solid #4f8cff; color: #4f8cff;
    font-size: 18px; letter-spacing: 2px; border-radius: 5px; cursor: pointer;
    transition: all 0.5s; opacity: 0; animation: fadeIn 2s forwards; animation-delay: 13s;
}
.btn:hover { background: #4f8cff; color: #000; box-shadow: 0 0 20px #4f8cff; }

/* --- ИНТЕРФЕЙС ИГРЫ --- */
.objective {
    position: absolute; top: 30px; left: 50%; transform: translateX(-50%);
    font-size: 20px; color: rgba(255, 255, 255, 0.5); z-index: 10;
    letter-spacing: 2px; text-transform: uppercase;
}

.story-text {
    position: absolute; bottom: 50px; width: 100%; text-align: center;
    font-size: 28px; font-style: italic; color: #fff; z-index: 10;
    text-shadow: 0 0 20px #4f8cff;
    opacity: 0; transition: opacity 2s ease; pointer-events: none;
}
