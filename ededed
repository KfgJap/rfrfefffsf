document.addEventListener("DOMContentLoaded", () => {

    // 1. КАСТОМНЫЙ КУРСОР
    const cursor = document.getElementById('cursor');
    const interactables = document.querySelectorAll('.interactive, .btn-play, .btn-version, .icon-btn');

    document.addEventListener('mousemove', (e) => {
        if (cursor) {
            cursor.style.left = e.clientX + 'px';
            cursor.style.top = e.clientY + 'px';
        }
    });

    interactables.forEach(el => {
        el.addEventListener('mouseenter', () => cursor.classList.add('hovering'));
        el.addEventListener('mouseleave', () => cursor.classList.remove('hovering'));
    });

    // 2. ВЫЕЗЖАЮЩЕЕ МЕНЮ НАСТРОЕК
    const menuBtn = document.getElementById('menuBtn');
    const sideMenu = document.getElementById('sideMenu');
    const closeMenuBtn = document.getElementById('closeMenuBtn');

    if (menuBtn && sideMenu && closeMenuBtn) {
        menuBtn.addEventListener('click', (e) => {
            e.stopPropagation(); 
            sideMenu.classList.add('open');
        });
        closeMenuBtn.addEventListener('click', () => {
            sideMenu.classList.remove('open');
        });
    }

    // 3. ПОЛЗУНОК ГРАФИКИ
    const track = document.getElementById('track');
    const fill = document.getElementById('fill');
    const thumb = document.getElementById('thumb');
    const sliderText = document.getElementById('slider-text');
    const starsBg = document.getElementById('starsBg');
    const canvas = document.getElementById('galaxyCanvas');
    let isDragging = false;

    if (track) {
        updateGraphicsUI(50);

        track.addEventListener('mousedown', (e) => {
            isDragging = true;
            track.classList.add('active');
            updateGraphicsSlider(e);
        });
        window.addEventListener('mousemove', (e) => {
            if (isDragging) updateGraphicsSlider(e);
        });
        window.addEventListener('mouseup', () => {
            if (isDragging) {
                isDragging = false;
                setTimeout(() => track.classList.remove('active'), 1000);
            }
        });

        function updateGraphicsSlider(e) {
            let rect = track.getBoundingClientRect();
            let x = Math.max(0, Math.min(100, ((e.clientX - rect.left) / rect.width) * 100));
            updateGraphicsUI(x);
        }

        function updateGraphicsUI(pos) {
            fill.style.width = pos + '%';
            thumb.style.left = pos + '%';

            if (pos < 33) {
                sliderText.textContent = 'Low';
                sliderText.style.left = '10%';
                canvas.style.opacity = '0.2'; starsBg.style.opacity = '0.1'; window.currentParticles = 1500; 
            } else if (pos > 66) {
                sliderText.textContent = 'High';
                sliderText.style.left = '90%';
                canvas.style.opacity = '1'; starsBg.style.opacity = '1'; window.currentParticles = 6000; 
            } else {
                sliderText.textContent = 'Medium';
                sliderText.style.left = '50%';
                canvas.style.opacity = '0.6'; starsBg.style.opacity = '0.5'; window.currentParticles = 3500; 
            }
        }
    }

    // 4. ПОЛЗУНОК ОЗУ
    const ramSlider = document.getElementById('ramSlider');
    const ramFill = document.getElementById('ramFill');
    const ramThumb = document.getElementById('ramThumb');
    const ramValue = document.getElementById('ramValue');
    let isDraggingRam = false;

    if (ramSlider) {
        ramSlider.addEventListener('mousedown', (e) => { isDraggingRam = true; updateRam(e); });
        window.addEventListener('mousemove', (e) => { if (isDraggingRam) updateRam(e); });
        window.addEventListener('mouseup', () => { isDraggingRam = false; });

        function updateRam(e) {
            let rect = ramSlider.getBoundingClientRect();
            let x = Math.max(0, Math.min(100, ((e.clientX - rect.left) / rect.width) * 100));
            let gb = Math.round(2 + (x / 100) * 14);
            ramFill.style.width = x + '%';
            ramThumb.style.left = x + '%';
            ramValue.textContent = gb + ' GB';
        }
    }

    // 5. ЛОГИКА ОКНА ВЕРСИЙ
    const versionBtn = document.getElementById('versionBtn');
    const versionModal = document.getElementById('versionModal');
    const closeVersionModal = document.getElementById('closeVersionModal');
    const versionItems = document.querySelectorAll('.version-item');
    const profileVersion = document.getElementById('profileVersion');

    if (versionBtn && versionModal) {
        versionBtn.addEventListener('click', () => versionModal.classList.add('open'));
        closeVersionModal.addEventListener('click', () => versionModal.classList.remove('open'));
        
        // Закрытие по клику на фон
        versionModal.addEventListener('click', (e) => {
            if (e.target === versionModal) versionModal.classList.remove('open');
        });

        versionItems.forEach(item => {
            item.addEventListener('click', () => {
                versionItems.forEach(i => i.classList.remove('active'));
                item.classList.add('active');
                profileVersion.textContent = item.getAttribute('data-version');
                versionModal.classList.remove('open');
            });
        });
    }

    // 6. ЛОГИКА ОКНА АККАУНТА
    const profileBtn = document.getElementById('profileBtn');
    const accountModal = document.getElementById('accountModal');
    const closeAccountModal = document.getElementById('closeAccountModal');
    const saveAccountBtn = document.getElementById('saveAccountBtn');
    const nicknameInput = document.getElementById('nicknameInput');
    const profileName = document.getElementById('profileName');

    if (profileBtn && accountModal) {
        profileBtn.addEventListener('click', () => accountModal.classList.add('open'));
        closeAccountModal.addEventListener('click', () => accountModal.classList.remove('open'));
        
        // Закрытие по клику на фон
        accountModal.addEventListener('click', (e) => {
            if (e.target === accountModal) accountModal.classList.remove('open');
        });

        saveAccountBtn.addEventListener('click', () => {
            const newName = nicknameInput.value.trim();
            if(newName) profileName.textContent = newName;
            accountModal.classList.remove('open');
        });
    }

    // 7. ЛОГИКА КНОПКИ PLAY (Имитация)
    const playBtn = document.getElementById('playBtn');
    if (playBtn) {
        playBtn.addEventListener('click', () => {
            if(playBtn.textContent === "PLAY") {
                playBtn.textContent = "LOADING...";
                playBtn.style.color = "var(--primary)";
                
                setTimeout(() => {
                    playBtn.textContent = "PLAY";
                    playBtn.style.color = "#000";
                }, 3000); // 3 секунды "загрузки"
            }
        });
    }
});
