<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <title>Space Launcher</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <style>
        :root {
            --accent: #5e9eff;
            --bg: #080a10;
            --panel: rgba(255, 255, 255, 0.03);
            --panel-hover: rgba(255, 255, 255, 0.08);
            --border: rgba(255, 255, 255, 0.06);
            --border-hover: rgba(94, 158, 255, 0.4);
            --text: #e2e8f0;
            --text-dim: #64748b;
            
            /* САМАЯ ЛЮТАЯ ПЛАВНОСТЬ (Пружина) */
            --smooth: cubic-bezier(0.16, 1, 0.3, 1);
        }

        * {
            margin: 0; padding: 0; box-sizing: border-box;
            font-family: 'Inter', sans-serif;
            user-select: none;
            -webkit-font-smoothing: antialiased;
        }

        body {
            height: 100vh;
            background: var(--bg);
            overflow: hidden; color: var(--text);
            display: flex; justify-content: center; align-items: center;
            position: relative;
        }

        /* ЖИВОЙ ФОН (Плавно дышит) */
        .bg-breath {
            position: absolute; top: 50%; left: 50%;
            transform: translate(-50%, -50%);
            width: 60vw; height: 60vh;
            background: radial-gradient(circle, rgba(94, 158, 255, 0.08) 0%, transparent 60%);
            filter: blur(40px);
            z-index: 0;
            pointer-events: none;
            animation: breathe 8s infinite alternate ease-in-out;
        }

        @keyframes breathe {
            0% { transform: translate(-50%, -50%) scale(1); opacity: 0.7; }
            100% { transform: translate(-50%, -50%) scale(1.2); opacity: 1; }
        }

        .stars {
            position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            background-image: 
                radial-gradient(1px 1px at 15% 25%, rgba(255,255,255,0.3), transparent),
                radial-gradient(1px 1px at 75% 65%, rgba(255,255,255,0.2), transparent),
                radial-gradient(1px 1px at 45% 85%, rgba(255,255,255,0.15), transparent);
            background-size: 400px 400px;
            z-index: 0;
            opacity: 0.6;
        }

        /* ПРОФИЛЬ */
        .profile {
            position: absolute; top: 32px; left: 32px;
            display: flex; align-items: center; gap: 12px;
            padding: 6px 16px 6px 6px;
            border-radius: 40px;
            background: var(--panel);
            border: 1px solid var(--border);
            z-index: 10;
            cursor: pointer;
            /* ЛЮТАЯ ПЛАВНОСТЬ */
            transition: all 0.8s var(--smooth);
        }

        .profile:hover {
            background: var(--panel-hover);
            border-color: var(--border-hover);
            transform: translateY(-2px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.3), 0 0 20px rgba(94, 158, 255, 0.1);
        }

        .avatar {
            width: 32px; height: 32px;
            border-radius: 50%;
            background: #1e2433;
            border: 1px solid rgba(255,255,255,0.1);
            transition: all 0.8s var(--smooth);
        }
        
        .profile:hover .avatar {
            border-color: var(--accent);
            box-shadow: 0 0 10px rgba(94, 158, 255, 0.3);
        }

        .nickname {
            font-size: 13px; font-weight: 500; color: var(--text);
        }

        /* НАСТРОЙКИ */
        .top-actions {
            position: absolute; top: 32px; right: 32px;
            display: flex; gap: 8px; z-index: 10;
        }

        .action-btn {
            width: 38px; height: 38px;
            border-radius: 12px;
            background: var(--panel);
            border: 1px solid var(--border);
            display: flex; justify-content: center; align-items: center;
            cursor: pointer;
            transition: all 0.8s var(--smooth);
        }

        .action-btn:hover {
            background: var(--panel-hover);
            border-color: var(--border-hover);
            transform: translateY(-3px) scale(1.05);
            box-shadow: 0 10px 20px rgba(0,0,0,0.2);
        }

        .action-btn svg {
            width: 16px; height: 16px;
            fill: var(--text-dim);
            transition: fill 0.6s var(--smooth);
        }

        .action-btn:hover svg { fill: var(--accent); }

        /* ЦЕНТР */
        .center {
            z-index: 10;
            display: flex; flex-direction: column;
            align-items: center; gap: 16px;
        }

        /* КНОПКА С ЛЮТОЙ ПЛАВНОСТЬЮ */
        .play-btn {
            background: var(--panel);
            border: 1px solid var(--border);
            color: var(--text);
            font-size: 15px; font-weight: 500;
            letter-spacing: 2px;
            padding: 16px 64px;
            border-radius: 16px;
            cursor: pointer;
            position: relative;
            overflow: hidden;
            
            /* ПЛАВНОСТЬ ВСЕГО */
            transition: all 0.8s var(--smooth);
        }

        /* Внутреннее свечение при наведении */
        .play-btn::before {
            content: '';
            position: absolute; inset: 0;
            background: radial-gradient(circle at center, rgba(94, 158, 255, 0.2) 0%, transparent 70%);
            opacity: 0;
            transition: opacity 0.8s var(--smooth);
            z-index: -1;
        }

        .play-btn:hover {
            background: var(--panel-hover);
            border-color: var(--border-hover);
            color: #fff;
            transform: translateY(-4px) scale(1.02);
            box-shadow: 0 15px 30px rgba(0,0,0,0.4), 0 0 30px rgba(94, 158, 255, 0.15);
        }

        .play-btn:hover::before { opacity: 1; }

        .version {
            font-size: 12px; color: var(--text-dim);
            cursor: pointer;
            transition: all 0.6s var(--smooth);
            letter-spacing: 0.5px;
        }

        .version:hover { color: var(--accent); transform: translateY(-2px); }

        /* ПАЛИТРА */
        .palette-btn {
            position: absolute; bottom: 32px; right: 32px;
            width: 42px; height: 42px;
            border-radius: 12px;
            background: var(--panel);
            border: 1px solid var(--border);
            display: flex; justify-content: center; align-items: center;
            cursor: pointer; z-index: 10;
            transition: all 0.8s var(--smooth);
        }

        .palette-btn svg {
            width: 18px; height: 18px;
            fill: var(--text-dim);
            transition: all 0.8s var(--smooth);
        }

        .palette-btn:hover {
            background: var(--panel-hover);
            border-color: var(--border-hover);
            transform: translateY(-4px) rotate(15deg);
            box-shadow: 0 10px 20px rgba(0,0,0,0.3), 0 0 20px rgba(94, 158, 255, 0.15);
        }

        .palette-btn:hover svg { fill: var(--accent); }

        /* ЦИТАТЫ - СУПЕР ПЛАВНЫЕ */
        .quotes {
            position: absolute; width: 100%; height: 100%;
            pointer-events: none; z-index: 1;
        }
        
        .quote {
            position: absolute;
            font-size: 12px; font-weight: 300;
            letter-spacing: 0.5px;
            color: rgba(255,255,255,0.08);
            animation: floatQuote 16s infinite linear;
            opacity: 0;
            transition: color 0.8s var(--smooth);
        }

        .q1 { top: 25%; left: 10%; animation-delay: 0s; }
        .q2 { top: 75%; left: 15%; animation-delay: 5.3s; }
        .q3 { top: 40%; right: 10%; animation-delay: 10.6s; }

        @keyframes floatQuote {
            0% { transform: translateY(0) scale(1); opacity: 0; }
            15% { opacity: 1; }
            85% { opacity: 1; }
            100% { transform: translateY(60px) scale(1.05); opacity: 0; }
        }
    </style>
</head>
<body>
    <div class="bg-breath"></div>
    <div class="stars"></div>
    
    <div class="quotes">
        <div class="quote q1">«Дорогу осилит идущий»</div>
        <div class="quote q2">«Не бойся ошибок, бойся бездействия»</div>
        <div class="quote q3">«Лучшее время начать — сегодня»</div>
    </div>

    <div class="profile">
        <div class="avatar"></div>
        <div class="nickname">Мик версия</div>
    </div>

    <div class="top-actions">
        <div class="action-btn">
