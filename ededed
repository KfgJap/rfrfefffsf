* { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Georgia', serif; }
body { background-color: #000; overflow: hidden; color: #fff; cursor: crosshair; }

canvas { display: block; width: 100vw; height: 100vh; }

/* МЕНЮ */
#mainMenu {
    position: absolute; inset: 0; z-index: 100;
    display: flex; flex-direction: column; justify-content: center; align-items: center;
    background: radial-gradient(circle, #0a1128 0%, #000 100%);
}
.title { font-size: 50px; text-align: center; line-height: 1.2; color: #e2e8f0; text-shadow: 0 0 30px #4f8cff; margin-bottom: 30px; letter-spacing: 5px; }

.missions-list {
    display: flex; flex-direction: column; gap: 10px; margin-bottom: 40px;
    background: rgba(255,255,255,0.05); padding: 20px; border-radius: 10px; border: 1px solid rgba(255,255,255,0.1);
}
.mission-item { font-size: 18px; color: #8892b0; display: flex; align-items: center; gap: 10px; }
.mission-item.completed { color: #4f8cff; text-decoration: line-through; }
.status { font-size: 24px; font-family: monospace; }

.btn {
    font-size: 18px; padding: 15px 50px; background: transparent; border: 1px solid #4f8cff; color: #4f8cff;
    cursor: pointer; transition: all 0.4s ease; text-transform: uppercase; letter-spacing: 3px; margin-bottom: 20px;
}
.btn:hover { background: #4f8cff; color: #000; box-shadow: 0 0 30px #4f8cff; }
.btn.small { position: absolute; top: 20px; right: 20px; padding: 10px 20px; font-size: 12px; margin: 0; }
.btn.reset { font-size: 12px; padding: 10px 20px; border-color: #a855f7; color: #a855f7; margin-top: 10px; }
.btn.reset:hover { background: #a855f7; color: #fff; box-shadow: 0 0 20px #a855f7; }

/* ИГРА */
.hud { position: absolute; inset: 0; pointer-events: none; z-index: 10; }
.objective { position: absolute; top: 30px; left: 30px; font-size: 22px; font-style: italic; color: #e2e8f0; text-shadow: 0 0 10px #4f8cff; }

/* ЭКРАН ПОБЕДЫ */
#victoryScreen {
    position: absolute; inset: 0; z-index: 50;
    background: rgba(0, 0, 0, 0.8);
    display: none; flex-direction: column; justify-content: center; align-items: center;
    backdrop-filter: blur(5px); text-align: center;
}
#victoryScreen.active { display: flex; animation: fadeIn 2s forwards; }
#victoryScreen h2 { font-size: 60px; color: #4f8cff; text-shadow: 0 0 40px #4f8cff; margin-bottom: 10px; }
#victoryScreen p { font-size: 24px; color: #fff; margin-bottom: 40px; }

@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
