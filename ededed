    <main class="center-col">
        <div class="main-card glass">
            <button class="play-btn interactive">
                <svg viewBox="0 0 24 24" style="width: 28px; height: 28px; fill: #fff;"><path d="M8 5v14l11-7z"/></svg>
                Играть
            </button>
            <button class="version-btn interactive">Выбрать версию</button>
