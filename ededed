<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Nebula Launcher</title>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary: #6366f1;
            --primary-glow: rgba(99, 102, 241, 0.4);
            --bg: #030407;
            --glass: rgba(255, 255, 255, 0.03);
            --glass-hover: rgba(255, 255, 255, 0.08);
            --border: rgba(255, 255, 255, 0.1);
            --text: #ffffff;
            --text-muted: #8892b0;
            --spring: cubic-bezier(0.34, 1.56, 0.64, 1);
            --smooth: cubic-bezier(0.16, 1, 0.3, 1);
        }

        * {
            margin: 0; padding: 0; box-sizing: border-box;
            font-family: 'Outfit', sans-serif; user-select: none;
            cursor: none; /* Скрываем стандартный курсор */
        }

        /* Исправление бага с кликами */
        body { height: 100vh; background: var(--bg); color: var(--text); overflow: hidden; position: relative; }

        /* --- КУРСОР --- */
        .cursor {
            position: fixed; width: 8px; height: 8px;
            background: var(--primary); border-radius: 50%;
            pointer-events: none; /* Пропускает клики сквозь себя */
            z-index: 9999; transform: translate(-50%, -50%);
            box-shadow: 0 0 15px var(--primary-glow);
            transition: width 0.3s var(--spring), height 0.3s var(--spring), background 0.3s, border 0.3s;
        }
        .cursor.hovering {
            width: 32px; height: 32px; background: transparent;
            border: 2px solid var(--primary);
        }

        /* --- ФОН --- */
        .stars-bg {
            position: absolute; inset: 0; z-index: 0; pointer-events: none;
            background-image: radial-gradient(1.5px 1.5px at 20% 30%, #fff, transparent),
                              radial-gradient(1px 1px at 70% 60%, #fff, transparent);
            background-size: 200px 200px; opacity: 0.3;
        }
        
        .galaxy-canvas {
            position: absolute; right: 5%; top: 50%; transform: translateY(-50%);
            width: 600px; height: 600px; z-index: 1; pointer-events: none; opacity: 0.9;
        }

        /* --- ИНТЕРФЕЙС --- */
        .ui-layer {
            position: absolute; inset: 0; z-index: 10;
            display: flex; flex-direction: column; justify-content: space-between;
            padding: 40px; pointer-events: none; /* Пропускаем клики в пустоту */
        }

        .top-bar {
            display: flex; justify-content: space-between; align-items: flex-start;
            pointer-events: auto; /* Включаем клики для панелей */
        }

        /* СТЕКЛО */
        .glass {
            background: var(--glass);
            backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
            border: 1px solid var(--border);
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5), inset 0 1px 0 rgba(255,255,255,0.1);
            transition: all 0.4s var(--smooth);
        }
        
        /* Наведение на кнопки */
        .glass:hover {
            background: var(--glass-hover);
            border-color: rgba(255, 255, 255, 0.25);
            transform: translateY(-3px) scale(1.02);
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.6), inset 0 1px 0 rgba(255,255,255,0.2);
        }

        /* ПРОФИЛЬ */
        .profile-wrapper { position: relative; }
        
        .profile-trigger {
            display: flex; align-items: center; gap: 12px;
            padding: 8px 20px 8px 8px; border-radius: 50px; cursor: pointer;
        }
        .avatar { width: 36px; height: 36px; border-radius: 50%; background: linear-gradient(135deg, var(--primary), #a855f7); }
        .user-info { display: flex; flex-direction: column; }
        .username { font-size: 15px; font-weight: 700; line-height: 1.2; }
        .version { font-size: 11px; color: var(--text-muted); font-weight: 600; letter-spacing: 0.5px; }

        /* ВЫПАДАЮЩЕЕ МЕНЮ */
        .dropdown {
            position: absolute; top: 115%; left: 0;
            width: 100%; padding: 10px;
            border-radius: 16px; display: flex; flex-direction: column; gap: 6px;
            opacity: 0; pointer-events: none;
            transform: translateY(-10px); transition: all 0.3s var(--spring);
            z-index: 20;
        }
        .dropdown.open { opacity: 1; pointer-events: auto; transform: translateY(0); }
        
        .dropdown button {
            background: transparent; border: none; color: white;
            padding: 10px 15px; border-radius: 10px; font-size: 13px; font-weight: 600;
            text-align: left; transition: all 0.3s var(--smooth); cursor: pointer;
        }
        .dropdown button:hover { background: rgba(255,255,255,0.1); padding-left: 20px; }
        .dropdown button.primary { color: var(--primary); font-weight: 800; }

        /* НАСТРОЙКИ И СОЦСЕТИ */
        .nav-actions { display: flex; gap: 10px; }
        .icon-btn {
            width: 44px; height: 44px; border-radius: 12px;
            display: flex; justify-content: center; align-items: center; cursor: pointer;
        }
        .icon-btn svg { width: 20px; height: 20px; fill: var(--text-muted); transition: fill 0.3s; }
        .icon-btn:hover svg { fill: var(--text); }

        /* КНОПКА PLAY */
        .center-play {
            position: absolute; left: 25%; top: 50%; transform: translate(-50%, -50%);
            pointer-events: auto; /* Включаем клики */
        }
        .btn-play {
            background: var(--glass); backdrop-filter: blur(20px); border: 1px solid var(--border);
            color: white; font-size: 24px; font-weight: 800; letter-spacing: 4px;
            padding: 20px 90px; border-radius: 16px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5), inset 0 1px 0 rgba(255,255,255,0.1);
            transition: all 0.4s var(--spring);
            position: relative; overflow: hidden; text-transform: uppercase; cursor: pointer;
        }
        .btn-play:hover {
            transform: translateY(-5px) scale(1.05);
            border-color: var(--primary);
            box-shadow: 0 20px 50px var(--primary-glow), inset 0 1px 0 rgba(255,255,255,0.3);
            background: rgba(99, 102, 241, 0.1);
        }

        /* ПОЛЗУНОК (ИСПРАВЛЕН) */
        .bottom-bar {
            display: flex; justify-content: center; position: absolute; bottom: 40px; left: 50%; transform: translateX(-50%);
            pointer-events: auto; /* Включаем клики */
        }
        .slider-container {
            display: flex; flex-direction: column; align-items: center; gap: 12px;
            background: var(--glass); backdrop-filter: blur(20px);
            border: 1px solid var(--border); padding: 15px 30px; border-radius: 20px;
        }
        .slider-label { font-size: 11px; font-weight: 800; color: var(--text-muted); letter-spacing: 2px; text-transform: uppercase; }
        
        .slider-track {
            width: 260px; height: 6px; background: rgba(255, 255, 255, 0.1);
            border-radius: 3px; position: relative; cursor: pointer;
            pointer-events: auto; /* Теперь ползунок можно тянуть */
        }
        .slider-fill {
            position: absolute; left: 0; top: 0; height: 100%; width: 50%;
            background: var(--primary); border-radius: 3px; pointer-events: none;
            box-shadow: 0 0 10px var(--primary-glow);
        }
        .slider-thumb {
            position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%);
            width: 18px; height: 18px; background: #fff; border-radius: 50%;
            box-shadow: 0 0 15px var(--primary); transition: transform 0.2s;
            pointer-events: none; /* Курсор не блокирует захват */
        }
        .slider-track:hover .slider-thumb { transform: translate(-50%, -50%) scale(1.2); }
        
        .slider-text {
            position: absolute; top: -35px; left: 50%; transform: translateX(-50%);
            font-size: 12px; font-weight: 800; color: var(--primary);
            opacity: 0; transition: 0.3s; letter-spacing: 1px; pointer-events: none;
        }
        .slider-track:hover .slider-text, .slider-track.active .slider-text { opacity: 1; }

    </style>
</head>
<body>
    <div class="cursor" id="cursor"></div>
    <div class="stars-bg"></div>
    <canvas class="galaxy-canvas" id="galaxyCanvas"></canvas>

    <div class="ui-layer">
        <div class="top-bar">
            
            <!-- ПРОФИЛЬ -->
            <div class="profile-wrapper">
                <div class="profile-trigger glass interactive" id="profileTrigger">
                    <div class="avatar"></div>
                    <div class="user-info">
                        <div class="username">Миша</div>
                        <div class="version">1.20.4</div>
                    </div>
                </div>
                <div class="dropdown glass" id="dropdownMenu">
                    <button class="interactive">Войти</button>
                    <button class="interactive primary">Регистрация</button>
                </div>
            </div>
            
            <!-- СОЦСЕТИ И НАСТРОЙКИ -->
            <div class="nav-actions">
                <div class="icon-btn glass interactive">
                    <svg viewBox="0 0 24 24"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z"/></svg>
                </div>
                <div class="icon-btn glass interactive">
                    <svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69.01-.03.01-.14-.07-.19-.08-.05-.19-.02-.27 0-.11.03-1.84 1.17-5.19 3.44-.49.34-.94.5-1.34.49-.44-.01-1.29-.25-1.92-.46-.78-.26-1.4-.4-1.35-.85.02-.23.35-.47.98-.72 3.85-1.68 6.42-2.78 7.71-3.32 3.66-1.52 4.42-1.79 4.91-1.8.11 0 .35.03.5.13.13.09.17.21.18.3.01.09.02.27.01.36z"/></svg>
                </div>
                <div class="icon-btn glass interactive">
                    <svg viewBox="0 0 24 24"><path d="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.06-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61 l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41 h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.73,8.87 C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.06,0.94l-2.03,1.58 c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54 c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96 c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.49-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6 s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z"/></svg>
                </div>
            </div>
        </div>
    </div>

    <div class="center-play">
        <button class="btn-play interactive">Play</button>
    </div>

    <div class="bottom-bar">
        <div class="slider-container">
            <div class="slider-label">Graphics Quality</div>
            <div class="slider-track interactive" id="track">
                <div class="slider-fill" id="fill"></div>
                <div class="slider-thumb" id="thumb"></div>
                <div class="slider-text" id="slider-text">Medium</div>
            </div>
        </div>
    </div>

    <script>
        // 1. КУРСОР
        const cursor = document.getElementById('cursor');
        const interactables = document.querySelectorAll('.interactive');
        document.addEventListener('mousemove', (e) => {
            cursor.style.left = e.clientX + 'px';
            cursor.style.top = e.clientY + 'px';
        });
        interactables.forEach(el => {
            el.addEventListener('mouseenter', () => cursor.classList.add('hovering'));
            el.addEventListener('mouseleave', () => cursor.classList.remove('hovering'));
        });

        // 2. ВЫПАДАЮЩЕЕ МЕНЮ
        const profileTrigger = document.getElementById('profileTrigger');
        const dropdownMenu = document.getElementById('dropdownMenu');
        
        profileTrigger.addEventListener('click', (e) => {
            e.stopPropagation(); 
            dropdownMenu.classList.toggle('open');
        });
        document.addEventListener('click', () => {
            dropdownMenu.classList.remove('open');
        });

        // 3. ПОЛЗУНОК
        const track = document.getElementById('track');
        const fill = document.getElementById('fill');
        const thumb = document.getElementById('thumb');
        const sliderText = document.getElementById('slider-text');
        let isDragging = false;

        updateUI(50);

        track.addEventListener('mousedown', (e) => {
            isDragging = true;
            track.classList.add('active');
            updateSlider(e);
        });

        window.addEventListener('mousemove', (e) => {
            if (isDragging) updateSlider(e);
        });

        window.addEventListener('mouseup', () => {
            if (isDragging) {
                isDragging = false;
                setTimeout(() => track.classList.remove('active'), 1000);
            }
        });

        function updateSlider(e) {
            let rect = track.getBoundingClientRect();
            let x = Math.max(0, Math.min(100, ((e.clientX - rect.left) / rect.width) * 100));
            updateUI(x);
        }

        function updateUI(pos) {
            fill.style.width = pos + '%';
            thumb.style.left = pos + '%';

            if (pos < 33) {
                sliderText.textContent = 'Low';
                sliderText.style.left = '10%';
            } else if (pos > 66) {
                sliderText.textContent = 'High';
                sliderText.style.left = '90%';
            } else {
                sliderText.textContent = 'Medium';
                sliderText.style.left = '50%';
            }
        }

        // 4. ГАЛАКТИКА
        const canvas = document.getElementById('galaxyCanvas');
        const ctx = canvas.getContext('2d');
        
        let width = canvas.width = 600;
        let height = canvas.height = 600;
        let centerX = width / 2;
        let centerY = height / 2;

        const particles = [];
        const numParticles = 1500;
        const arms = 3; 
        const spiralTightness = 3.5;

        for (let i = 0; i < numParticles; i++) {
            const armIndex = i % arms;
            const angleOffset = (armIndex * (Math.PI * 2)) / arms;
            const distance = Math.random() * 250 + 10;
            const angle = distance * 0.01 * spiralTightness + angleOffset + (Math.random() - 0.5) * 0.5;
            
            const x = Math.cos(angle) * distance + (Math.random() - 0.5) * 30;
            const y = Math.sin(angle) * distance + (Math.random() - 0.5) * 30;

            const size = Math.random() * 1.5 + 0.5;
            const opacity = Math.random() * 0.5 + 0.3;
            const color = Math.random() > 0.5 ? `rgba(99, 102, 241, ${opacity})` : `rgba(168, 85, 247, ${opacity})`;

            particles.push({ x, y, size, color, distance, angleOffset });
        }

        let rotation = 0;

        function animateGalaxy() {
            ctx.clearRect(0, 0, width, height);
            rotation += 0.001;

            ctx.beginPath();
            ctx.arc(centerX, centerY, 40, 0, Math.PI * 2);
            ctx.fillStyle = 'rgba(255, 255, 255, 0.8)';
            ctx.shadowBlur = 80;
            ctx.shadowColor = '#6366f1';
            ctx.fill();
            ctx.shadowBlur = 0;

            particles.forEach(p => {
                const rotatedX = p.x * Math.cos(rotation) - p.y * Math.sin(rotation);
                const rotatedY = p.x * Math.sin(rotation) + p.y * Math.cos(rotation);

                ctx.beginPath();
                ctx.arc(centerX + rotatedX, centerY + rotatedY, p.size, 0, Math.PI * 2);
                ctx.fillStyle = p.color;
                ctx.fill();
            });

            requestAnimationFrame(animateGalaxy);
        }

        animateGalaxy();
    </script>
</body>
</html>
