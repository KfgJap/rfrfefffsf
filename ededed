// ==========================================
// ЛОГИКА ПАЛИТРЫ ЦВЕТОВ
// ==========================================

const paletteBtn = document.getElementById('paletteBtn');
const colorPopup = document.getElementById('colorPopup');
const colorWheel = document.getElementById('colorWheel');
const wheelPicker = document.getElementById('wheelPicker');
let currentHue = 220; // Начальный оттенок (синий)

// Открытие/закрытие окна палитры
paletteBtn.addEventListener('click', (e) => {
    e.stopPropagation();
    colorPopup.classList.toggle('open');
});

// Обработка выбора цвета
let isPickingColor = false;

colorWheel.addEventListener('mousedown', (e) => { 
    isPickingColor = true; 
    pickColor(e); 
});

window.addEventListener('mousemove', (e) => { 
    if (isPickingColor) pickColor(e); 
});

window.addEventListener('mouseup', () => { 
    isPickingColor = false; 
});

function pickColor(e) {
    let rect = colorWheel.getBoundingClientRect();
    let x = e.clientX - rect.left - rect.width / 2;
    let y = e.clientY - rect.top - rect.height / 2;
    
    let radius = Math.sqrt(x*x + y*y);
    let maxRadius = rect.width / 2;
    
    let lightness = 60;
    let saturation = 100;
    
    // Если кликнули в самый центр - ставим белый цвет
    if (radius < maxRadius * 0.15) {
        lightness = 100;
        saturation = 0;
    } else {
        // Иначе вычисляем угол (оттенок)
        let angle = Math.atan2(y, x) * (180 / Math.PI) + 90;
        if (angle < 0) angle += 360;
        currentHue = angle;
    }

    // Меняем глобальные CSS переменные
    let hex = `hsl(${currentHue}, ${saturation}%, ${lightness}%)`;
    document.documentElement.style.setProperty('--primary', hex);
    
    // Меняем цвет свечения (с прозрачностью)
    let rgba = `hsla(${currentHue}, ${saturation}%, ${lightness}%, 0.3)`;
    document.documentElement.style.setProperty('--primary-glow', rgba);

    // Двигаем кружок-маркер по палитре
    let radiusLimit = maxRadius - 8;
    let px = Math.cos(currentHue * Math.PI / 180 - Math.PI / 2) * (radius < maxRadius * 0.15 ? 0 : radiusLimit) + rect.width / 2;
    let py = Math.sin(currentHue * Math.PI / 180 - Math.PI / 2) * (radius < maxRadius * 0.15 ? 0 : radiusLimit) + rect.height / 2;
    
    wheelPicker.style.left = px + 'px';
    wheelPicker.style.top = py + 'px';
    wheelPicker.style.background = hex;
}
