    <!-- Кнопка вызова палитры -->
    <div class="palette-btn glass interactive" id="paletteBtn">
        <svg viewBox="0 0 24 24"><path d="M12 3c-4.97 0-9 4.03-9 9s4.03 9 9 9c.83 0 1.5-.67 1.5-1.5 0-.39-.15-.74-.39-1.01-.23-.26-.38-.61-.38-.99 0-.83.67-1.5 1.5-1.5H16c2.76 0 5-2.24 5-5 0-4.42-4.03-8-9-8zm-5.5 9c-.83 0-1.5-.67-1.5-1.5S5.67 9 6.5 9 8 9.67 8 10.5 7.33 12 6.5 12zm3-4C8.67 8 8 7.33 8 6.5S8.67 5 9.5 5s1.5.67 1.5 1.5S10.33 8 9.5 8zm5 0c-.83 0-1.5-.67-1.5-1.5S13.67 5 14.5 5s1.5.67 1.5 1.5S15.33 8 14.5 8zm3 4c-.83 0-1.5-.67-1.5-1.5S16.67 9 17.5 9s1.5.67 1.5 1.5-.67 1.5-1.5 1.5z"/></svg>
    </div>

    <!-- Окно палитры -->
    <div class="palette-popup glass" id="palettePopup">
        <div class="color-wheel interactive" id="colorWheel">
            <div class="wheel-picker" id="wheelPicker"></div>
        </div>
        <div class="hex-box">
            <div class="hex-label">HEX</div>
            <input type="text" class="hex-input interactive" id="hexInput" value="#5E9EFF" maxlength="7">
        </div>
    </div>

    <script>
        // --- КУРСОР ---
        const cursor = document.getElementById('cursor');
        const interactables = document.querySelectorAll('.interactive');
        document.addEventListener('mousemove', (e) => {
            cursor.style.left = e.clientX + 'px';
            cursor.style.top = e.clientY + 'px';
        });
        interactables.forEach(el => {
            el.addEventListener('mouseenter', () => cursor.classList.add('hovering'));
            el.addEventListener('mouseleave', () => cursor.classList.remove('hovering'));
        });

        // --- ПАЛИТРА ---
        const paletteBtn = document.getElementById('paletteBtn');
        const palettePopup = document.getElementById('palettePopup');
        const wheel = document.getElementById('colorWheel');
        const picker = document.getElementById('wheelPicker');
        const hexInput = document.getElementById('hexInput');
        
        let currentHue = 215; // Синий
        let currentSat = 100;
        let currentLight = 60;

        // Открытие/закрытие окна
        paletteBtn.addEventListener('click', () => {
            palettePopup.classList.toggle('open');
            paletteBtn.classList.toggle('active');
        });

        // Преобразование HSL в HEX
        function hslToHex(h, s, l) {
            l /= 100;
            const a = s * Math.min(l, 1 - l) / 100;
            const f = n => {
                const k = (n + h / 30) % 12;
                const color = l - a * Math.max(Math.min(k - 3, 9 - k, 1), -1);
                return Math.round(255 * color).toString(16).padStart(2, '0');
            };
            return `#${f(0)}${f(8)}${f(4)}`;
        }

        function updateTheme(hex) {
            document.documentElement.style.setProperty('--accent', hex);
            let r = parseInt(hex.slice(1,3), 16) || 0;
            let g = parseInt(hex.slice(3,5), 16) || 0;
            let b = parseInt(hex.slice(5,7), 16) || 0;
            document.documentElement.style.setProperty('--accent-glow', `rgba(${r}, ${g}, ${b}, 0.4)`);
            hexInput.value = hex.toUpperCase();
            picker.style.background = hex;
        }

        // Выбор цвета на круге
        wheel.addEventListener('mousemove', (e) => {
            if (e.buttons !== 1) return;
            let rect = wheel.getBoundingClientRect();
            let x = e.clientX - rect.left - rect.width / 2;
            let y = e.clientY - rect.top - rect.height / 2;
            
            let angle = Math.atan2(y, x) * (180 / Math.PI) + 90;
            if (angle < 0) angle += 360;
            currentHue = angle;
            
            let radius = rect.width / 2 - 8;
            let px = Math.cos(angle * Math.PI / 180 - Math.PI / 2) * radius + rect.width / 2;
            let py = Math.sin(angle * Math.PI / 180 - Math.PI / 2) * radius + rect.height / 2;
            
            picker.style.left = px + 'px';
            picker.style.top = py + 'px';
            
            let hex = hslToHex(currentHue, currentSat, currentLight);
            updateTheme(hex);
        });

        // Ввод HEX
        hexInput.addEventListener('input', (e) => {
            let val = e.target.value;
            if (val.length === 7 && val.startsWith('#')) {
                updateTheme(val);
            }
        });

        // Инициализация
        let initHex = hslToHex(currentHue, currentSat, currentLight);
        updateTheme(initHex);
        picker.style.left = '75%'; picker.style.top = '15%';

        // --- ПОЛЗУНОК ---
        const track = document.getElementById('sliderTrack');
        const fill = document.getElementById('sliderFill');
        const thumb = document.getElementById('sliderThumb');
        const marks = [document.getElementById('mark0'), document.getElementById('mark1'), document.getElementById('mark2')];
        const wrapper = document.getElementById('sliderWrapper');
        let isDragging = false;

        function updateUI(pos) {
            fill.style.width = pos + '%';
            thumb.style.left = pos + '%';
            let idx = pos < 25 ? 0 : pos > 75 ? 2 : 1;
            marks.forEach((m, i) => m.classList.toggle('active', i === idx));
        }

        track.addEventListener('mousedown', (e) => { 
            isDragging = true; 
            wrapper.classList.add('active');
            move(e); 
        });
        
        window.addEventListener('mousemove', (e) => { if (isDragging) move(e); });
        
        window.addEventListener('mouseup', () => {
            if (isDragging) {
                isDragging = false;
                let rect = track.getBoundingClientRect();
                let x = Math.max(0, Math.min(100, ((thumb.getBoundingClientRect().left + 11 - rect.left) / rect.width) * 100));
                if (x < 25) updateUI(0);
                else if (x > 75) updateUI(100);
                else updateUI(50);
                
                setTimeout(() => wrapper.classList.remove('active'), 1000);
            }
        });

        function move(e) {
            if (!isDragging) return;
            let rect = track.getBoundingClientRect();
            let x = Math.max(0, Math.min(100, ((e.clientX - rect.left) / rect.width) * 100));
            updateUI(x);
        }
    </script>
</body>
</html>
