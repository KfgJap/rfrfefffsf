<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Nebula Launcher</title>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary: #6366f1;
            --primary-glow: rgba(99, 102, 241, 0.6);
            --bg: #020308;
            --text: #ffffff;
            --text-muted: #64748b;
            --smooth: cubic-bezier(0.16, 1, 0.3, 1);
        }

        * {
            margin: 0; padding: 0; box-sizing: border-box;
            font-family: 'Montserrat', sans-serif; user-select: none;
            cursor: none;
        }

        body {
            height: 100vh;
            background-color: var(--bg);
            color: var(--text);
            overflow: hidden;
        }

        /* --- КУРСОР --- */
        .cursor {
            position: fixed; width: 8px; height: 8px;
            background: var(--primary); border-radius: 50%;
            pointer-events: none; z-index: 9999;
            transform: translate(-50%, -50%);
            box-shadow: 0 0 15px var(--primary-glow);
            transition: width 0.3s, height 0.3s, background 0.3s, border 0.3s;
        }
        .cursor.hovering {
            width: 32px; height: 32px; background: transparent;
            border: 2px solid var(--primary);
        }

        /* --- ФОН --- */
        .stars-bg {
            position: absolute; inset: 0; z-index: 0; pointer-events: none;
            background-image: 
                radial-gradient(1px 1px at 10% 20%, #fff, transparent),
                radial-gradient(1.5px 1.5px at 80% 40%, #fff, transparent),
                radial-gradient(2px 2px at 40% 80%, #fff, transparent);
            background-size: 300px 300px; opacity: 0.4;
        }

        /* --- ГАЛАКТИКА --- */
        .galaxy-canvas {
            position: absolute; right: 10%; top: 50%; transform: translateY(-50%);
            width: 800px; height: 800px; z-index: 1; pointer-events: none;
            mix-blend-mode: screen; /* Делает ярче, убирает тусклость */
        }

        /* --- ИНТЕРФЕЙС --- */
        .ui-layer {
            position: absolute; inset: 0; z-index: 10;
            display: flex; flex-direction: column; justify-content: space-between;
            padding: 40px; pointer-events: none;
        }

        .top-bar {
            display: flex; justify-content: space-between; align-items: flex-start;
            pointer-events: auto;
        }

        /* СТЕКЛО */
        .glass {
            background: rgba(20, 25, 40, 0.4);
            backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.1);
            transition: all 0.4s var(--smooth);
        }

        /* ПРОФИЛЬ */
        .profile-trigger {
            display: flex; align-items: center; gap: 15px;
            padding: 8px 25px 8px 8px; border-radius: 50px; cursor: pointer;
        }
        .profile-trigger:hover {
            background: rgba(255, 255, 255, 0.08); border-color: rgba(255, 255, 255, 0.3);
            transform: translateY(-2px);
        }
        .avatar { width: 40px; height: 40px; border-radius: 50%; background: linear-gradient(135deg, var(--primary), #a855f7); }
        .user-info { display: flex; flex-direction: column; }
        .username { font-size: 16px; font-weight: 700; }
        .version { font-size: 11px; color: var(--text-muted); font-weight: 600; }

        /* КНОПКА PLAY */
        .center-play {
            position: absolute; left: 30%; top: 50%; transform: translate(-50%, -50%);
            pointer-events: auto; display: flex; flex-direction: column; align-items: center; gap: 20px;
        }
        .btn-play {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.15);
            color: white; font-size: 26px; font-weight: 800; letter-spacing: 5px;
            padding: 24px 110px; border-radius: 20px;
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.2);
            transition: all 0.4s var(--smooth);
            text-transform: uppercase; cursor: pointer; position: relative;
            overflow: hidden;
        }
        .btn-play:hover {
            transform: translateY(-5px) scale(1.05);
            background: rgba(99, 102, 241, 0.15);
            border-color: var(--primary);
            box-shadow: 0 20px 60px var(--primary-glow), inset 0 1px 0 rgba(255, 255, 255, 0.4);
        }
        
        .btn-version {
            background: transparent; border: none; color: var(--text-muted);
            font-size: 14px; font-weight: 600; cursor: pointer; letter-spacing: 1px;
            transition: color 0.3s;
        }
        .btn-version:hover { color: white; }

        /* ПОЛЗУНОК */
        .bottom-bar {
            display: flex; justify-content: center; position: absolute; bottom: 40px; left: 50%; transform: translateX(-50%);
            pointer-events: auto;
        }
        .slider-container {
            display: flex; flex-direction: column; align-items: center; gap: 10px;
        }
        .slider-label { font-size: 12px; font-weight: 800; color: var(--text-muted); letter-spacing: 2px; text-transform: uppercase; }
        
        .slider-track {
            width: 300px; height: 4px; background: rgba(255, 255, 255, 0.1);
            border-radius: 2px; position: relative; cursor: pointer; pointer-events: auto;
        }
        .slider-fill {
            position: absolute; left: 0; top: 0; height: 100%; width: 50%;
            background: var(--primary); border-radius: 2px; pointer-events: none;
            box-shadow: 0 0 10px var(--primary-glow);
        }
        .slider-thumb {
            position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%);
            width: 16px; height: 16px; background: #fff; border-radius: 50%;
            box-shadow: 0 0 15px var(--primary-glow); pointer-events: none; transition: transform 0.2s;
        }
        .slider-track:hover .slider-thumb { transform: translate(-50%, -50%) scale(1.3); }
        
        .slider-text {
            position: absolute; top: -30px; left: 50%; transform: translateX(-50%);
            font-size: 12px; font-weight: 800; color: var(--primary);
            opacity: 0; transition: 0.3s; pointer-events: none;
        }
        .slider-track:hover .slider-text, .slider-track.active .slider-text { opacity: 1; }

        /* НАСТРОЙКИ */
        .top-right { pointer-events: auto; display: flex; gap: 10px; }
        .icon-btn { width: 44px; height: 44px; border-radius: 12px; display: flex; justify-content: center; align-items: center; cursor: pointer; }
        .icon-btn:hover { background: rgba(255, 255, 255, 0.1); border-color: rgba(255, 255, 255, 0.3); }
        .icon-btn svg { width: 20px; height: 20px; fill: var(--text-muted); transition: fill 0.3s; }
        .icon-btn:hover svg { fill: white; }

    </style>
</head>
<body>
    <div class="cursor" id="cursor"></div>
    <div class="stars-bg"></div>
    
    <canvas class="galaxy-canvas" id="galaxyCanvas"></canvas>

    <div class="ui-layer">
        <div class="top-bar">
            <div class="profile-trigger glass interactive">
                <div class="avatar"></div>
                <div class="user-info">
                    <div class="username">Миша</div>
                    <div class="version">1.20.4</div>
                </div>
            </div>
            
            <div class="top-right">
                <div class="icon-btn glass interactive">
                    <svg viewBox="0 0 24 24"><path d="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.06-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61 l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41 h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.73,8.87 C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.06,0.94l-2.03,1.58 c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54 c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96 c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.49-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6 s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z"/></svg>
                </div>
                <div class="icon-btn glass interactive">
                    <svg viewBox="0 0 24 24"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg>
                </div>
            </div>
        </div>
    </div>

    <div class="center-play">
        <button class="btn-play interactive">Play</button>
        <button class="btn-version interactive">Select Version</button>
    </div>

    <div class="bottom-bar">
        <div class="slider-container">
            <div class="slider-label">Graphics</div>
            <div class="slider-track interactive" id="track">
                <div class="slider-fill" id="fill"></div>
                <div class="slider-thumb" id="thumb"></div>
                <div class="slider-text" id="slider-text">Medium</div>
            </div>
        </div>
    </div>

    <script>
        // 1. КУРСОР
        const cursor = document.getElementById('cursor');
        const interactables = document.querySelectorAll('.interactive, .btn-play, .icon-btn, .profile-trigger, .btn-version');
        document.addEventListener('mousemove', (e) => {
            cursor.style.left = e.clientX + 'px';
            cursor.style.top = e.clientY + 'px';
        });
        interactables.forEach(el => {
            el.addEventListener('mouseenter', () => cursor.classList.add('hovering'));
            el.addEventListener('mouseleave', () => cursor.classList.remove('hovering'));
        });

        // 2. ПОЛЗУНОК
        const track = document.getElementById('track');
        const fill = document.getElementById('fill');
        const thumb = document.getElementById('thumb');
        const sliderText = document.getElementById('slider-text');
        let isDragging = false;

        updateUI(50);

        track.addEventListener('mousedown', (e) => {
            isDragging = true;
            track.classList.add('active');
            updateSlider(e);
        });

        window.addEventListener('mousemove', (e) => {
            if (isDragging) updateSlider(e);
        });

        window.addEventListener('mouseup', () => {
            if (isDragging) {
                isDragging = false;
                setTimeout(() => track.classList.remove('active'), 1000);
            }
        });

        function updateSlider(e) {
            let rect = track.getBoundingClientRect();
            let x = Math.max(0, Math.min(100, ((e.clientX - rect.left) / rect.width) * 100));
            updateUI(x);
        }

        function updateUI(pos) {
            fill.style.width = pos + '%';
            thumb.style.left = pos + '%';

            if (pos < 33) {
                sliderText.textContent = 'Low';
                sliderText.style.left = '10%';
            } else if (pos > 66) {
                sliderText.textContent = 'High';
                sliderText.style.left = '90%';
            } else {
                sliderText.textContent = 'Medium';
                sliderText.style.left = '50%';
            }
        }

        // 3. ГАЛАКТИКА (МАКСИМАЛЬНО ПЛОТНАЯ И ЯРКАЯ)
        const canvas = document.getElementById('galaxyCanvas');
        const ctx = canvas.getContext('2d');
        
        let width = canvas.width = 800;
        let height = canvas.height = 800;
        let centerX = width / 2;
        let centerY = height / 2;

        // Увеличиваем количество частиц в 10 раз
        const particles = [];
        const numParticles = 20000; 
        const arms = 4; // 4 рукава для красоты
        const spiralTightness = 4.5;

        for (let i = 0; i < numParticles; i++) {
            const armIndex = i % arms;
            const angleOffset = (armIndex * (Math.PI * 2)) / arms;
            
            // Распределение плотности: больше частиц к центру
            const distance = Math.pow(Math.random(), 0.6) * 350 + 10; 
            
            const angle = distance * 0.01 * spiralTightness + angleOffset + (Math.random() - 0.5) * 0.8;
            
            // Разброс частиц вокруг рукава
            const spread = 15 + (distance * 0.05); 
            const x = Math.cos(angle) * distance + (Math.random() - 0.5) * spread;
            const y = Math.sin(angle) * distance + (Math.random() - 0.5) * spread;

            const size = Math.random() * 1.5 + 0.3;
            const opacity = Math.random() * 0.6 + 0.4;
            
            // Цвета: от белого/голубого в центре до фиолетового на краях
            let color;
            if (distance < 100) {
                color = `rgba(255, 255, 255, ${opacity})`;
            } else if (distance < 200) {
                color = `rgba(99, 102, 241, ${opacity})`;
            } else {
                color = `rgba(168, 85, 247, ${opacity})`;
            }

            particles.push({ x, y, size, color });
        }

        let rotation = 0;

        function animateGalaxy() {
            // Очищаем с легким шлейфом для эффекта свечения
            ctx.clearRect(0, 0, width, height);
            rotation += 0.0008;

            // Свечение ядра
            const gradient = ctx.createRadialGradient(centerX, centerY, 0, centerX, centerY, 150);
            gradient.addColorStop(0, 'rgba(255, 255, 255, 0.8)');
            gradient.addColorStop(0.2, 'rgba(99, 102, 241, 0.4)');
            gradient.addColorStop(1, 'transparent');
            
            ctx.beginPath();
            ctx.arc(centerX, centerY, 150, 0, Math.PI * 2);
            ctx.fillStyle = gradient;
            ctx.fill();

            // Отрисовка частиц с аддитивным смешиванием (lighter) для яркости
            ctx.globalCompositeOperation = 'lighter';
            
            particles.forEach(p => {
                const rotatedX = p.x * Math.cos(rotation) - p.y * Math.sin(rotation);
                const rotatedY = p.x * Math.sin(rotation) + p.y * Math.cos(rotation);

                ctx.beginPath();
                ctx.arc(centerX + rotatedX, centerY + rotatedY, p.size, 0, Math.PI * 2);
                ctx.fillStyle = p.color;
                ctx.fill();
            });

            // Возвращаем стандартный режим
            ctx.globalCompositeOperation = 'source-over';

            requestAnimationFrame(animateGalaxy);
        }

        animateGalaxy();
    </script>
</body>
</html>
