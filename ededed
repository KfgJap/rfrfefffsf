<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>GALACTIC Launcher</title>
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            /* Переменная цвета, которую мы будем менять */
            --primary: #4f8cff;
            --primary-glow: rgba(79, 140, 255, 0.3);
            --bg: #04060b;
            --surface: rgba(18, 24, 38, 0.5);
            --surface-hover: rgba(30, 40, 60, 0.7);
            --border: rgba(255, 255, 255, 0.08);
            --text: #ffffff;
            --text-muted: #8b9bb4;
            --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
            --spring: cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        * {
            margin: 0; padding: 0; box-sizing: border-box;
            font-family: 'Syne', sans-serif; user-select: none; cursor: none;
        }

        body {
            height: 100vh;
            background-color: var(--bg);
            background-image: radial-gradient(circle at 50% 50%, #0a1128 0%, #04060b 100%);
            color: var(--text);
            overflow: hidden;
        }

        /* --- КУРСОР --- */
        .cursor {
            position: fixed; width: 8px; height: 8px;
            background: var(--primary); border-radius: 50%;
            pointer-events: none; z-index: 9999;
            transform: translate(-50%, -50%);
            box-shadow: 0 0 15px var(--primary-glow);
            transition: width 0.3s var(--ease-out), height 0.3s var(--ease-out), background 0.3s, border 0.3s;
        }
        .cursor.hovering {
            width: 32px; height: 32px; background: rgba(255, 255, 255, 0.05);
            border: 1.5px solid var(--primary);
        }

        /* --- ГАЛАКТИКА (с Canvas) --- */
        .galaxy-canvas {
            position: absolute; right: 0; top: 50%; transform: translateY(-50%);
            width: 1000px; height: 1000px; z-index: 1; pointer-events: none;
            mix-blend-mode: screen; opacity: 0.8;
            transition: opacity 0.5s ease;
        }

        /* --- ЛОГОТИП --- */
        .logo {
            position: absolute; top: 40px; left: 50%; transform: translateX(-50%);
            font-size: 26px; font-weight: 800; letter-spacing: 12px; 
            color: #fff; z-index: 20; text-shadow: 0 0 20px var(--primary-glow);
        }

        /* --- UI СЛОЙ --- */
        .ui-layer {
            position: absolute; inset: 0; z-index: 10;
            display: flex; flex-direction: column; padding: 40px 50px; pointer-events: none;
        }

        /* --- ПАНЕЛИ --- */
        .ui-panel {
            background: var(--surface);
            backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
            border: 1px solid var(--border);
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
            border-radius: 12px;
            transition: all 0.3s var(--ease-out);
        }
        .ui-panel:hover {
            background: var(--surface-hover); border-color: rgba(255, 255, 255, 0.15);
            transform: translateY(-2px); box-shadow: 0 8px 30px rgba(0, 0, 0, 0.4);
        }

        /* --- ВЕРХНЯЯ ПАНЕЛЬ --- */
        .top-bar { display: flex; justify-content: space-between; align-items: flex-start; pointer-events: auto; z-index: 30; }
        .top-left { display: flex; align-items: center; gap: 15px; }

        .menu-btn { width: 46px; height: 46px; border-radius: 12px; display: flex; justify-content: center; align-items: center; cursor: pointer; }
        .menu-btn svg { width: 22px; height: 22px; fill: var(--text-muted); transition: fill 0.3s; }
        .menu-btn:hover svg { fill: var(--primary); }

        .profile-card { display: flex; align-items: center; gap: 15px; padding: 8px 20px 8px 8px; cursor: pointer; }
        .avatar { width: 40px; height: 40px; border-radius: 8px; background: linear-gradient(135deg, var(--primary), #a855f7); }
        .user-info { display: flex; flex-direction: column; }
        .username { font-size: 15px; font-weight: 700; }
        .version { font-size: 11px; color: var(--primary); font-weight: 600; }

        /* --- МЕНЮ СЛЕВА --- */
        .side-menu {
            position: absolute; top: 0; left: -350px; width: 320px; height: 100vh;
            background: rgba(10, 15, 25, 0.95); backdrop-filter: blur(30px);
            border-right: 1px solid var(--border); z-index: 100; padding: 30px;
            display: flex; flex-direction: column; gap: 30px; transition: left 0.4s var(--ease-out);
        }
        .side-menu.open { left: 0; }

        .menu-title { font-size: 20px; font-weight: 800; letter-spacing: 2px; color: #fff; margin-top: 40px; }
        .settings-group { display: flex; flex-direction: column; gap: 10px; }
        .settings-group label { font-size: 12px; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 1px; }

        /* Ползунок ОЗУ */
        .ram-slider { width: 100%; height: 4px; background: rgba(255,255,255,0.1); border-radius: 2px; position: relative; cursor: pointer; }
        .ram-fill { position: absolute; left: 0; top: 0; height: 100%; width: 40%; background: var(--primary); border-radius: 2px; }
        .ram-thumb { position: absolute; left: 40%; top: 50%; transform: translate(-50%, -50%); width: 14px; height: 14px; background: #fff; border-radius: 50%; pointer-events: none; }
        .ram-value { font-size: 14px; font-weight: 700; color: var(--primary); text-align: right; margin-top: 5px; }

        /* Кнопки папок */
        .folder-btn {
            display: flex; align-items: center; gap: 12px; padding: 14px; border-radius: 10px;
            background: rgba(255,255,255,0.02); border: 1px solid var(--border);
            color: #fff; font-size: 13px; font-weight: 600; cursor: pointer; transition: all 0.3s;
        }
        .folder-btn:hover { background: rgba(255,255,255,0.06); border-color: rgba(255,255,255,0.2); }
        .folder-btn svg { width: 18px; height: 18px; fill: var(--text-muted); }

        /* --- КНОПКА PLAY --- */
        .center-play {
            position: absolute; left: 55%; top: 50%; transform: translate(-50%, -50%);
            pointer-events: auto; display: flex; flex-direction: column; align-items: center; gap: 15px; z-index: 20;
        }
        .btn-play {
            position: relative; background: #ffffff; color: #000000; font-size: 24px; font-weight: 800; letter-spacing: 6px;
            padding: 22px 110px; border-radius: 16px; border: none;
            box-shadow: 0 10px 30px rgba(255, 255, 255, 0.1); cursor: pointer; transition: all 0.3s var(--spring);
        }
        .btn-play:hover {
            transform: translateY(-4px) scale(1.02); color: var(--primary);
            box-shadow: 0 15px 40px rgba(255, 255, 255, 0.2), 0 0 20px var(--primary-glow);
        }
        .btn-version { background: transparent; border: none; color: var(--text-muted); font-size: 13px; font-weight: 600; letter-spacing: 1px; cursor: pointer; }
        .btn-version:hover { color: #fff; }

        /* --- ИКОНКИ СПРАВА --- */
        .nav-actions { display: flex; gap: 12px; }
        .icon-btn { width: 46px; height: 46px; border-radius: 12px; display: flex; justify-content: center; align-items: center; cursor: pointer; }
        .icon-btn svg { width: 20px; height: 20px; fill: var(--text-muted); transition: fill 0.3s; }
        .icon-btn:hover svg { fill: #fff; }

        /* --- ПОЛЗУНОК ГРАФИКИ --- */
        .bottom-bar { display: flex; justify-content: center; position: absolute; bottom: 40px; left: 50%; transform: translateX(-50%); pointer-events: auto; z-index: 20; }
        .slider-wrapper { display: flex; align-items: center; gap: 25px; padding: 15px 35px; border-radius: 16px; }
        .slider-label { font-size: 12px; font-weight: 700; color: var(--text-muted); letter-spacing: 2px; text-transform: uppercase; }
        .slider-track { width: 250px; height: 4px; background: rgba(0, 0, 0, 0.6); border-radius: 2px; position: relative; cursor: pointer; }
        .slider-fill { position: absolute; left: 0; top: 0; height: 100%; width: 50%; background: var(--primary); border-radius: 2px; pointer-events: none; }
        .slider-thumb { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); width: 14px; height: 14px; background: #fff; border-radius: 50%; pointer-events: none; transition: transform 0.2s var(--spring); }
        .slider-track:hover .slider-thumb { transform: translate(-50%, -50%) scale(1.2); }
        .slider-text { position: absolute; top: -30px; left: 50%; transform: translateX(-50%); font-size: 12px; font-weight: 700; color: var(--primary); opacity: 0; transition: 0.3s; pointer-events: none; }
        .slider-track:hover .slider-text, .slider-track.active .slider-text { opacity: 1; }

        /* --- ПАЛИТРА --- */
        .palette-btn {
            position: absolute; bottom: 40px; right: 50px; width: 50px; height: 50px;
            border-radius: 14px; display: flex; justify-content: center; align-items: center;
            cursor: pointer; z-index: 30; pointer-events: auto;
        }
        .palette-btn svg { width: 24px; height: 24px; fill: var(--text); transition: fill 0.3s; }
        .palette-btn:hover svg { fill: var(--primary); }

        .color-picker-popup {
            position: absolute; bottom: 110px; right: 50px;
            padding: 20px; border-radius: 20px; z-index: 30; pointer-events: auto;
            display: flex; flex-direction: column; gap: 15px; align-items: center;
            opacity: 0; pointer-events: none; transform: translateY(20px);
            transition: all 0.4s var(--ease-out);
        }
        .color-picker-popup.open { opacity: 1; pointer-events: all; transform: translateY(0); }

        .color-wheel {
            width: 120px; height: 120px; border-radius: 50%;
            background: conic-gradient(red, yellow, lime, aqua, blue, magenta, red);
            position: relative; cursor: crosshair; box-shadow: 0 0 20px rgba(0,0,0,0.5);
        }
        .wheel-picker {
            position: absolute; width: 16px; height: 16px; border-radius: 50%;
            border: 2px solid #fff; background: var(--primary);
            transform: translate(-50%, -50%); pointer-events: none;
        }
    </style>
</head>
<body>
    <div class="cursor" id="cursor"></div>
    <canvas class="galaxy-canvas" id="galaxyCanvas"></canvas>

    <div class="logo">GALACTIC</div>

    <!-- МЕНЮ -->
    <div class="side-menu" id="sideMenu">
        <div class="menu-title">Settings</div>
        <div class="settings-group">
            <label>Выделение ОЗУ (RAM)</label>
            <div class="ram-slider interactive" id="ramSlider">
                <div class="ram-fill" id="ramFill"></div>
                <div class="ram-thumb" id="ramThumb"></div>
            </div>
            <div class="ram-value" id="ramValue">4 GB</div>
        </div>
        <div class="settings-group">
            <label>Папки игры</label>
            <div class="folder-btn interactive">
                <svg viewBox="0 0 24 24"><path d="M20 6h-8l-2-2H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm0 12H4V8h16v10z"/></svg>
                Открыть .minecraft
            </div>
            <div class="folder-btn interactive">
                <svg viewBox="0 0 24 24"><path d="M20 6h-8l-2-2H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm0 12H4V8h16v10z"/></svg>
                Открыть папку mods
            </div>
        </div>
    </div>

    <div class="ui-layer">
        <div class="top-bar">
            <div class="top-left">
                <div class="menu-btn ui-panel interactive" id="menuBtn">
                    <svg viewBox="0 0 24 24"><path d="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z"/></svg>
                </div>
                <div class="profile-card ui-panel interactive">
                    <div class="avatar"></div>
                    <div class="user-info">
                        <div class="username">User</div>
                        <div class="version">1.20.4</div>
                    </div>
                </div>
            </div>
            <div class="nav-actions">
                <div class="icon-btn ui-panel interactive">
                    <svg viewBox="0 0 24 24"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z"/></svg>
                </div>
                <div class="icon-btn ui-panel interactive">
                    <svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69.01-.03.01-.14-.07-.19-.08-.05-.19-.02-.27 0-.11.03-1.84 1.17-5.19 3.44-.49.34-.94.5-1.34.49-.44-.01-1.29-.25-1.92-.46-.78-.26-1.4-.4-1.35-.85.02-.23.35-.47.98-.72 3.85-1.68 6.42-2.78 7.71-3.32 3.66-1.52 4.42-1.79 4.91-1.8.11 0 .35.03.5.13.13.09.17.21.18.3.01.09.02.27.01.36z"/></svg>
                </div>
            </div>
        </div>
    </div>

    <div class="center-play">
        <button class="btn-play interactive">PLAY</button>
        <button class="btn-version interactive">Select Version</button>
    </div>

    <div class="bottom-bar">
        <div class="slider-wrapper ui-panel">
            <div class="slider-label">Graphics</div>
            <div class="slider-track interactive" id="track">
                <div class="slider-fill" id="fill"></div>
                <div class="slider-thumb" id="thumb"></div>
                <div class="slider-text" id="slider-text">Medium</div>
            </div>
        </div>
    </div>

    <!-- ПАЛИТРА -->
    <div class="palette-btn ui-panel interactive" id="paletteBtn">
        <svg viewBox="0 0 24 24"><path d="M12 3c-4.97 0-9 4.03-9 9s4.03 9 9 9c.83 0 1.5-.67 1.5-1.5 0-.39-.15-.74-.39-1.01-.23-.26-.38-.61-.38-.99 0-.83.67-1.5 1.5-1.5H16c2.76 0 5-2.24 5-5 0-4.42-4.03-8-9-8zm-5.5 9c-.83 0-1.5-.67-1.5-1.5S5.67 9 6.5 9 8 9.67 8 10.5 7.33 12 6.5 12zm3-4C8.67 8 8 7.33 8 6.5S8.67 5 9.5 5s1.5.67 1.5 1.5S10.33 8 9.5 8zm5 0c-.83 0-1.5-.67-1.5-1.5S13.67 5 14.5 5s1.5.67 1.5 1.5S15.33 8 14.5 8zm3 4c-.83 0-1.5-.67-1.5-1.5S16.67 9 17.5 9s1.5.67 1.5 1.5-.67 1.5-1.5 1.5z"/></svg>
    </div>

    <div class="color-picker-popup ui-panel" id="colorPopup">
        <div class="color-wheel interactive" id="colorWheel">
            <div class="wheel-picker" id="wheelPicker"></div>
        </div>
    </div>

    <script>
        // 1. КУРСОР
        const cursor = document.getElementById('cursor');
        const interactables = document.querySelectorAll('.interactive, .btn-play, .btn-version');
        document.addEventListener('mousemove', (e) => {
            cursor.style.left = e.clientX + 'px';
            cursor.style.top = e.clientY + 'px';
        });
        interactables.forEach(el => {
            el.addEventListener('mouseenter', () => cursor.classList.add('hovering'));
            el.addEventListener('mouseleave', () => cursor.classList.remove('hovering'));
        });

        // 2. МЕНЮ
        document.getElementById('menuBtn').addEventListener('click', (e) => {
            e.stopPropagation(); 
            document.getElementById('sideMenu').classList.toggle('open');
        });

        // 3. ПАЛИТРА (Открытие окна)
        const paletteBtn = document.getElementById('paletteBtn');
        const colorPopup = document.getElementById('colorPopup');
        const colorWheel = document.getElementById('colorWheel');
        const wheelPicker = document.getElementById('wheelPicker');
        let currentHue = 220; // Начальный синий

        paletteBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            colorPopup.classList.toggle('open');
        });

        // Выбор цвета (двигаем по кругу)
        let isPickingColor = false;
        colorWheel.addEventListener('mousedown', (e) => { isPickingColor = true; pickColor(e); });
        window.addEventListener('mousemove', (e) => { if (isPickingColor) pickColor(e); });
        window.addEventListener('mouseup', () => { isPickingColor = false; });

        function pickColor(e) {
            let rect = colorWheel.getBoundingClientRect();
            let x = e.clientX - rect.left - rect.width / 2;
            let y = e.clientY - rect.top - rect.height / 2;
            
            let angle = Math.atan2(y, x) * (180 / Math.PI) + 90;
            if (angle < 0) angle += 360;
            currentHue = angle;

            // Меняем CSS переменную
            let hex = `hsl(${currentHue}, 100%, 60%)`;
            document.documentElement.style.setProperty('--primary', hex);
            
            // Для прозрачности (glow)
            let rgba = `hsla(${currentHue}, 100%, 60%, 0.3)`;
            document.documentElement.style.setProperty('--primary-glow', rgba);

            // Двигаем маркер
            let radius = rect.width / 2 - 8;
            let px = Math.cos(angle * Math.PI / 180 - Math.PI / 2) * radius + rect.width / 2;
            let py = Math.sin(angle * Math.PI / 180 - Math.PI / 2) * radius + rect.height / 2;
            wheelPicker.style.left = px + 'px';
            wheelPicker.style.top = py + 'px';
            wheelPicker.style.background = hex;
        }
        pickColor({ clientX: colorWheel.getBoundingClientRect().left + colorWheel.getBoundingClientRect().width/2, clientY: colorWheel.getBoundingClientRect().top + 10 });

        // 4. ПОЛЗУНОК ГРАФИКИ (РЕАЛЬНЫЙ)
        const track = document.getElementById('track');
        const fill = document.getElementById('fill');
        const thumb = document.getElementById('thumb');
        const sliderText = document.getElementById('slider-text');
        let isDragging = false;

        updateGraphicsUI(50); // Начальное положение

        track.addEventListener('mousedown', (e) => {
            isDragging = true;
            track.classList.add('active');
            updateGraphicsSlider(e);
        });

        window.addEventListener('mousemove', (e) => {
            if (isDragging) updateGraphicsSlider(e);
        });

        window.addEventListener('mouseup', () => {
            if (isDragging) {
                isDragging = false;
                setTimeout(() => track.classList.remove('active'), 1000);
            }
        });

        function updateGraphicsSlider(e) {
            let rect = track.getBoundingClientRect();
            let x = Math.max(0, Math.min(100, ((e.clientX - rect.left) / rect.width) * 100));
            updateGraphicsUI(x);
        }

        function updateGraphicsUI(pos) {
            fill.style.width = pos + '%';
            thumb.style.left = pos + '%';

            const canvas = document.getElementById('galaxyCanvas');
            const canvasParent = canvas.parentElement;

            if (pos < 33) {
                sliderText.textContent = 'Low (Fast)';
                sliderText.style.left = '10%';
                // Снижаем нагрузку
                canvas.style.opacity = '0.2';
                // Тут в реальной игре мы бы отключали тени и т.д.
            } else if (pos > 66) {
                sliderText.textContent = 'High (Quality)';
                sliderText.style.left = '90%';
                // Максимальная красота
                canvas.style.opacity = '1';
            } else {
                sliderText.textContent = 'Medium';
                sliderText.style.left = '50%';
                canvas.style.opacity = '0.7';
            }
        }

        // 5. ПОЛЗУНОК ОЗУ
        const ramSlider = document.getElementById('ramSlider');
        const ramFill = document.getElementById('ramFill');
        const ramThumb = document.getElementById('ramThumb');
        const ramValue = document.getElementById('ramValue');
        let isDraggingRam = false;

        ramSlider.addEventListener('mousedown', (e) => { isDraggingRam = true; updateRam(e); });
        window.addEventListener('mousemove', (e) => { if (isDraggingRam) updateRam(e); });
        window.addEventListener('mouseup', () => { isDraggingRam = false; });

        function updateRam(e) {
            let rect = ramSlider.getBoundingClientRect();
            let x = Math.max(0, Math.min(100, ((e.clientX - rect.left) / rect.width) * 100));
            let gb = Math.round(2 + (x / 100) * 14);
            ramFill.style.width = x + '%';
            ramThumb.style.left = x + '%';
            ramValue.textContent = gb + ' GB';
        }

        // 6. ГАЛАКТИКА
        const canvas = document.getElementById('galaxyCanvas');
        const ctx = canvas.getContext('2d');
        
        let width = canvas.width = 1000;
        let height = canvas.height = 1000;
        let centerX = width / 2;
        let centerY = height / 2;

        const particles = [];
        const numParticles = 6000; 
        const arms = 3; 
        const spiralTightness = 4.0;

        for (let i = 0; i < numParticles; i++) {
            const armIndex = i % arms;
            const angleOffset = (armIndex * (Math.PI * 2)) / arms;
            const distance = Math.pow(Math.random(), 0.7) * 450 + 10; 
            const angle = distance * 0.01 * spiralTightness + angleOffset + (Math.random() - 0.5) * 0.6;
            const spread = 10 + (distance * 0.06); 
            const x = Math.cos(angle) * distance + (Math.random() - 0.5) * spread;
            const y = Math.sin(angle) * distance + (Math.random() - 0.5) * spread;

            const size = Math.random() * 1.8 + 0.4;
            const opacity = Math.random() * 0.7 + 0.3;
            
            let color;
            if (distance < 120) {
                color = `rgba(255, 255, 255, ${opacity})`;
            } else if (distance < 250) {
                color = `rgba(79, 140, 255, ${opacity})`;
            } else {
                color = `rgba(168, 85, 247, ${opacity})`;
            }

            particles.push({ x, y, size, color });
        }

        let rotation = 0;

        function animateGalaxy() {
            ctx.clearRect(0, 0, width, height);
            rotation += 0.0008;

            // Мы берем текущий цвет из CSS переменной
            let currentColor = getComputedStyle(document.documentElement).getPropertyValue('--primary').trim();
            
            const gradient = ctx.createRadialGradient(centerX, centerY, 0, centerX, centerY, 180);
            gradient.addColorStop(0, 'rgba(255, 255, 255, 1)');
            gradient.addColorStop(0.1, currentColor);
            gradient.addColorStop(0.4, 'transparent');
            
            ctx.beginPath();
            ctx.arc(centerX, centerY, 180, 0, Math.PI * 2);
            ctx.fillStyle = gradient;
            ctx.fill();

            ctx.globalCompositeOperation = 'lighter';
            
            particles.forEach(p => {
                const rotatedX = p.x * Math.cos(rotation) - p.y * Math.sin(rotation);
                const rotatedY = p.x * Math.sin(rotation) + p.y * Math.cos(rotation);

                ctx.beginPath();
                ctx.arc(centerX + rotatedX, centerY + rotatedY, p.size, 0, Math.PI * 2);
                // Перекрашиваем частицы в текущий цвет
                if (p.color.includes('79, 140, 255')) {
                     ctx.fillStyle = currentColor; // Делаем основной цвет динамическим
                } else {
                     ctx.fillStyle = p.color;
                }
                ctx.fill();
            });

            ctx.globalCompositeOperation = 'source-over';
            requestAnimationFrame(animateGalaxy);
        }

        animateGalaxy();
    </script>
</body>
</html>
