<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nebula Launcher</title>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --accent: #5e9eff;
            --accent-glow: rgba(94, 158, 255, 0.4);
            --bg: #020308;
            --panel: rgba(15, 22, 40, 0.4);
            --panel-hover: rgba(30, 45, 80, 0.6);
            --border: rgba(255, 255, 255, 0.1);
            --text: #f1f5f9;
            --text-dim: #8892b0;
            
            --spring: cubic-bezier(0.34, 1.56, 0.64, 1);
            --smooth: cubic-bezier(0.16, 1, 0.3, 1);
        }

        * {
            margin: 0; padding: 0; box-sizing: border-box;
            font-family: 'Manrope', sans-serif;
            user-select: none;
            cursor: none;
        }

        body {
            height: 100vh;
            background: var(--bg);
            overflow: hidden; color: var(--text);
            display: flex; flex-direction: column;
        }

        /* КУРСОР */
        .cursor {
            position: fixed; width: 8px; height: 8px;
            background: var(--accent); border-radius: 50%;
            pointer-events: none; z-index: 9999;
            transform: translate(-50%, -50%);
            box-shadow: 0 0 15px var(--accent);
            transition: width 0.4s var(--spring), height 0.4s var(--spring), background 0.3s, border 0.3s;
        }
        .cursor.hovering {
            width: 32px; height: 32px; background: transparent;
            border: 2px solid var(--accent);
        }

        /* КОСМОС */
        .cosmos { position: absolute; inset: 0; pointer-events: none; z-index: 0; overflow: hidden; }
        .nebula {
            position: absolute; border-radius: 50%; filter: blur(120px);
            opacity: 0.5; animation: drift 25s infinite alternate ease-in-out;
        }
        .nebula-1 { width: 80vw; height: 80vh; background: radial-gradient(circle, var(--accent-glow) 0%, transparent 70%); top: -30%; left: -20%; }
        .nebula-2 { width: 70vw; height: 70vh; background: radial-gradient(circle, rgba(138, 43, 226, 0.2) 0%, transparent 70%); bottom: -20%; right: -20%; animation-delay: -12s; animation-duration: 30s; }
        @keyframes drift { 0% { transform: translate(0, 0) scale(1); } 100% { transform: translate(120px, 80px) scale(1.1); } }

        .stars {
            position: absolute; inset: -50%;
            background-image: 
                radial-gradient(1.5px 1.5px at 20% 30%, #fff, transparent),
                radial-gradient(1px 1px at 70% 60%, #fff, transparent),
                radial-gradient(2px 2px at 40% 80%, #fff, transparent);
            background-size: 350px 350px; z-index: 1; opacity: 0.7;
            animation: rotate 150s linear infinite;
        }
        @keyframes rotate { 100% { transform: rotate(5deg); } }

        /* СТЕКЛО */
        .glass {
            background: var(--panel); backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px);
            border: 1px solid var(--border);
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5), inset 0 1px 0 rgba(255,255,255,0.1);
            transition: all 0.6s var(--spring);
        }
        .glass:hover {
            background: var(--panel-hover); border-color: var(--accent);
            box-shadow: 0 15px 50px rgba(0, 0, 0, 0.6), 0 0 35px var(--accent-glow), inset 0 1px 0 rgba(255,255,255,0.2);
            transform: translateY(-3px) scale(1.01);
        }

        /* ВЕРХ */
        .top-bar { height: 80px; padding: 0 40px; display: flex; justify-content: space-between; align-items: center; z-index: 10; }
        .logo { font-size: 22px; font-weight: 800; letter-spacing: 3px; text-transform: uppercase; color: #fff; }
        .logo span { color: var(--accent); transition: color 0.4s; }
        .nav-icons { display: flex; gap: 12px; }
        .nav-btn { width: 44px; height: 44px; border-radius: 14px; display: flex; justify-content: center; align-items: center; cursor: pointer; }
        .nav-btn svg { width: 20px; height: 20px; fill: var(--text-dim); transition: fill 0.4s; }
        .nav-btn:hover svg { fill: var(--accent); }

        /* ЛЕВЫЙ УГОЛ */
        .left-col { position: absolute; top: 100px; left: 40px; display: flex; flex-direction: column; gap: 20px; z-index: 10; }
        .profile { display: flex; align-items: center; gap: 15px; padding: 10px 25px 10px 10px; border-radius: 50px; cursor: pointer; }
        .avatar { width: 45px; height: 45px; border-radius: 50%; background: #1e2433; border: 1px solid var(--accent); box-shadow: 0 0 15px var(--accent-glow); }
        .nickname { font-size: 15px; font-weight: 700; letter-spacing: 0.5px; }
        .socials { display: flex; gap: 12px; }
        .social-btn { width: 46px; height: 46px; border-radius: 14px; display: flex; justify-content: center; align-items: center; cursor: pointer; }
        .social-btn svg { width: 22px; height: 22px; fill: var(--text-dim); transition: all 0.4s var(--spring); }
        .social-btn:hover svg { fill: #fff; transform: scale(1.15); }

        /* ЦЕНТР */
        .center-col { flex: 1; display: flex; justify-content: center; align-items: center; z-index: 10; }
        .main-card { display: flex; flex-direction: column; align-items: center; gap: 25px; padding: 50px 80px; border-radius: 30px; }
        .play-btn {
            display: flex; align-items: center; justify-content: center; gap: 15px;
            background: linear-gradient(180deg, rgba(255,255,255,0.15) 0%, rgba(255,255,255,0.03) 100%);
            border: 1.5px solid var(--accent);
            color: #fff; font-size: 26px; font-weight: 800; letter-spacing: 5px;
            padding: 22px 90px; border-radius: 20px;
            position: relative; overflow: hidden; cursor: pointer;
            box-shadow: 0 0 40px var(--accent-glow), inset 0 1px 0 rgba(255,255,255,0.4);
            transition: all 0.6s var(--spring);
            text-transform: uppercase;
        }
        .play-btn::before {
            content: ''; position: absolute; top: 0; left: -100%; width: 50%; height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.4), transparent);
            transform: skewX(-25deg); transition: left 0.7s var(--smooth);
        }
        .play-btn:hover { transform: translateY(-5px) scale(1.03); box-shadow: 0 0 80px var(--accent-glow), inset 0 1px 0 rgba(255,255,255,0.5); }
        .play-btn:hover::before { left: 150%; }
        .version-btn { font-size: 14px; font-weight: 700; color: var(--text-dim); background: transparent; border: none; cursor: pointer; transition: color 0.4s; letter-spacing: 1px; }
        .version-btn:hover { color: #fff; text-shadow: 0 0 10px var(--accent-glow); }

        /* НИЖНИЙ ПОЛЗУНОК */
        .bottom-bar { height: 120px; display: flex; justify-content: center; align-items: center; z-index: 10; }
        .slider-wrapper { position: relative; display: flex; flex-direction: column; align-items: center; }
        
        .slider-labels {
            position: absolute; top: -35px; left: 50%; transform: translateX(-50%) translateY(10px);
            display: flex; gap: 30px; opacity: 0; pointer-events: none;
            transition: all 0.4s var(--spring); z-index: 20;
        }
        .slider-wrapper:hover .slider-labels, .slider-wrapper.active .slider-labels {
            opacity: 1; transform: translateX(-50%) translateY(0);
        }
        .label-item { font-size: 13px; font-weight: 800; color: var(--text-dim); text-transform: uppercase; transition: color 0.3s, text-shadow 0.3s; letter-spacing: 1px; }
        .label-item.active { color: var(--accent); text-shadow: 0 0 15px var(--accent-glow); }

        .slider-box { display: flex; align-items: center; gap: 20px; padding: 12px 30px; border-radius: 50px; }
        .track { position: relative; width: 280px; height: 6px; background: rgba(255,255,255,0.1); border-radius: 3px; cursor: pointer; }
        .fill { position: absolute; top: 0; left: 0; height: 100%; background: var(--accent); border-radius: 3px; width: 50%; transition: width 0.5s var(--spring); box-shadow: 0 0 10px var(--accent-glow); }
        .thumb { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 22px; height: 22px; background: #fff; border-radius: 50%; box-shadow: 0 0 20px var(--accent); transition: left 0.5s var(--spring), transform 0.3s var(--spring); }
        .track:hover .thumb { transform: translate(-50%, -50%) scale(1.2); }

        /* ПАЛИТРА (Кнопка) */
        .palette-btn {
            position: absolute; bottom: 40px; right: 40px;
            width: 54px; height: 54px; border-radius: 16px;
            display: flex; justify-content: center; align-items: center;
            cursor: pointer; z-index: 20;
        }
        .palette-btn svg { width: 24px; height: 24px; fill: var(--text-dim); transition: fill 0.3s; }
        .palette-btn:hover svg, .palette-btn.active svg { fill: var(--accent); }

        /* ВЫПАДАЮЩЕЕ ОКНО ПАЛИТРЫ */
        .palette-popup {
            position: absolute; bottom: 105px; right: 40px;
            width: 320px; padding: 24px; border-radius: 24px;
            display: flex; align-items: center; gap: 20px;
            z-index: 20;
            opacity: 0; pointer-events: none;
            transform: translateY(20px) scale(0.95);
            transform-origin: bottom right;
            transition: all 0.5s var(--spring);
        }
        .palette-popup.open {
            opacity: 1; pointer-events: all;
            transform: translateY(0) scale(1);
        }

        .color-wheel {
            position: relative; width: 90px; height: 90px;
            border-radius: 50%; flex-shrink: 0;
            background: conic-gradient(from 90deg, red, yellow, lime, aqua, blue, magenta, red);
            cursor: crosshair;
            box-shadow: 0 0 20px rgba(0,0,0,0.6), inset 0 0 15px rgba(0,0,0,0.5);
            border: 2px solid rgba(255,255,255,0.15);
            transition: transform 0.3s var(--spring);
        }
        .color-wheel:hover { transform: scale(1.05); }
        .wheel-picker {
            position: absolute; width: 16px; height: 16px;
            border-radius: 50%; border: 2px solid #fff;
            transform: translate(-50%, -50%); pointer-events: none;
            box-shadow: 0 0 10px rgba(0,0,0,0.8);
            background: var(--accent);
        }

        .hex-box { display: flex; flex-direction: column; gap: 8px; flex: 1; }
        .hex-label { font-size: 11px; font-weight: 800; color: var(--text-dim); text-transform: uppercase; letter-spacing: 1px; }
        .hex-input {
            width: 100%; height: 45px; border-radius: 12px;
            background: rgba(0,0,0,0.4); border: 1px solid var(--border);
            color: #fff; font-family: monospace; font-size: 16px; text-align: center;
            outline: none; transition: border 0.3s, box-shadow 0.3s; letter-spacing: 1px;
        }
        .hex-input:focus { border-color: var(--accent); box-shadow: 0 0 15px var(--accent-glow); }
    </style>
</head>
<body>
