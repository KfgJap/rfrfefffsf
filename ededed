<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <title>Space Launcher</title>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;800&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Manrope', sans-serif; }
        body { height: 100vh; background: #020308; color: white; overflow: hidden; position: relative; }
        
        /* КОСМОС */
        .galaxy {
            position: absolute; top: 50%; left: 50%; width: 200vw; height: 200vw;
            background: conic-gradient(from 0deg, transparent, rgba(94, 158, 255, 0.15), transparent, rgba(138, 43, 226, 0.1), transparent);
            border-radius: 50%; filter: blur(80px); transform: translate(-50%, -50%);
            animation: spin 100s linear infinite; z-index: 0;
        }
        @keyframes spin { 100% { transform: translate(-50%, -50%) rotate(360deg); } }
        
        .nebula {
            position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
            width: 80vw; height: 80vh; background: radial-gradient(circle, rgba(94, 158, 255, 0.15) 0%, transparent 60%);
            filter: blur(100px); z-index: 0;
        }

        /* ИНТЕРФЕЙС */
        .ui { position: absolute; inset: 0; z-index: 10; display: flex; flex-direction: column; }
        
        .top { display: flex; justify-content: space-between; padding: 40px; }
        .btn { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); padding: 12px 24px; border-radius: 12px; color: white; cursor: pointer; transition: 0.3s; }
        .btn:hover { background: rgba(94, 158, 255, 0.2); border-color: #5e9eff; }

        .center { flex: 1; display: flex; justify-content: center; align-items: center; }
        .play {
            background: linear-gradient(180deg, rgba(94, 158, 255, 0.3), transparent);
            border: 1.5px solid #5e9eff; color: white; font-size: 24px; font-weight: 800; letter-spacing: 4px;
            padding: 20px 80px; border-radius: 16px; cursor: pointer; transition: 0.4s;
            box-shadow: 0 0 30px rgba(94, 158, 255, 0.3);
        }
        .play:hover { transform: translateY(-3px); box-shadow: 0 0 60px rgba(94, 158, 255, 0.6); }

        .bottom { padding: 40px; display: flex; justify-content: center; }
        .slider-box { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); padding: 15px 30px; border-radius: 50px; display: flex; align-items: center; gap: 20px; }
        .slider-track { width: 200px; height: 6px; background: rgba(255,255,255,0.1); border-radius: 3px; position: relative; }
        .slider-fill { position: absolute; left: 0; top: 0; height: 100%; width: 50%; background: #5e9eff; border-radius: 3px; box-shadow: 0 0 10px #5e9eff; }
        .slider-thumb { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); width: 18px; height: 18px; background: white; border-radius: 50%; }
    </style>
</head>
<body>
    <div class="galaxy"></div>
    <div class="nebula"></div>

    <div class="ui">
        <div class="top">
            <button class="btn">Войти в аккаунт</button>
            <button class="btn">Настройки</button>
        </div>
        <div class="center">
            <button class="play">Играть</button>
        </div>
        <div class="bottom">
            <div class="slider-box">
                <span style="font-size: 12px; font-weight: bold; color: #8892b0;">ГРАФИКА</span>
                <div class="slider-track">
                    <div class="slider-fill"></div>
                    <div class="slider-thumb"></div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
