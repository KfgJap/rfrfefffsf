// ==========================================
// ЛОГИКА ГАЛАКТИКИ (Canvas)
// ==========================================

const canvas = document.getElementById('galaxyCanvas');
const ctx = canvas.getContext('2d');

let width = canvas.width = 1000;
let height = canvas.height = 1000;
let centerX = width / 2;
let centerY = height / 2;

const particles = [];
const maxParticles = 6000; // Максимальное количество для High качества
const arms = 3; // Количество рукавов
const spiralTightness = 4.0;

// Генерация частиц (звезд)
for (let i = 0; i < maxParticles; i++) {
    const armIndex = i % arms;
    const angleOffset = (armIndex * (Math.PI * 2)) / arms;
    
    // Расстояние от центра (делаем плотнее к центру)
    const distance = Math.pow(Math.random(), 0.6) * 450 + 10; 
    
    // Угол с закручиванием
    const angle = distance * 0.01 * spiralTightness + angleOffset + (Math.random() - 0.5) * 0.8;
    
    // Разброс (чтобы рукава были не идеальной линией, а сгустком)
    const spread = 15 + (distance * 0.08); 
    const x = Math.cos(angle) * distance + (Math.random() - 0.5) * spread;
    const y = Math.sin(angle) * distance + (Math.random() - 0.5) * spread;

    const size = Math.random() * 2 + 0.4;
    const opacity = Math.random() * 0.8 + 0.2;
    
    // Окрашиваем частицы (центр - белый, середина - синяя, края - фиолетовые)
    let color;
    if (distance < 100) {
        color = `rgba(255, 255, 255, ${opacity})`;
    } else if (distance < 250) {
        color = `rgba(79, 140, 255, ${opacity})`; // Это цвет мы будем менять из палитры
    } else {
        color = `rgba(168, 85, 247, ${opacity})`;
    }

    particles.push({ x, y, size, color });
}

let rotation = 0;

// Эта переменная управляется ползунком графики из script.js
window.currentParticles = maxParticles; 

function animateGalaxy() {
    ctx.clearRect(0, 0, width, height);
    rotation += 0.0008; // Скорость вращения

    // Получаем текущий цвет из CSS переменных (чтобы галактика красилась вместе с кнопками)
    let currentColor = getComputedStyle(document.documentElement).getPropertyValue('--primary').trim();
    
    // Свечение в центре галактики
    const gradient = ctx.createRadialGradient(centerX, centerY, 0, centerX, centerY, 200);
    gradient.addColorStop(0, 'rgba(255, 255, 255, 1)');
    gradient.addColorStop(0.1, currentColor);
    gradient.addColorStop(0.5, 'transparent');
    
    ctx.beginPath();
    ctx.arc(centerX, centerY, 200, 0, Math.PI * 2);
    ctx.fillStyle = gradient;
    ctx.fill();

    // Включаем режим смешивания для яркости
    ctx.globalCompositeOperation = 'lighter';
    
    // Рисуем столько частиц, сколько разрешено ползунком
    for (let i = 0; i < window.currentParticles; i++) {
        const p = particles[i];
        
        // Вращаем каждую частицу
        const rotatedX = p.x * Math.cos(rotation) - p.y * Math.sin(rotation);
        const rotatedY = p.x * Math.sin(rotation) + p.y * Math.cos(rotation);

        ctx.beginPath();
        ctx.arc(centerX + rotatedX, centerY + rotatedY, p.size, 0, Math.PI * 2);
        
        // Если это частица из "синей" зоны, красим её в цвет палитры
        if (p.color.includes('79, 140, 255')) {
             ctx.fillStyle = currentColor; 
        } else {
             ctx.fillStyle = p.color;
        }
        ctx.fill();
    }

    ctx.globalCompositeOperation = 'source-over';
    requestAnimationFrame(animateGalaxy);
}

// Запуск анимации
animateGalaxy();
