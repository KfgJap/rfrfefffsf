<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <title>Space Launcher</title>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;500;700&family=Orbitron:wght@500;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --main-color: #00f0ff; 
            --bg-dark: #02040a;
            --bg-light: #0a1128;
            --glass: rgba(10, 17, 40, 0.4);
            --glass-border: rgba(0, 240, 255, 0.15);
            --text-muted: #8892b0;
        }

        * {
            margin: 0; padding: 0; box-sizing: border-box;
            font-family: 'Montserrat', sans-serif;
            user-select: none;
        }

        body {
            height: 100vh;
            background: radial-gradient(circle at center, var(--bg-light) 0%, var(--bg-dark) 100%);
            overflow: hidden; color: #fff;
            display: flex; justify-content: center; align-items: center;
            position: relative;
        }

        /* МЕДЛЕННЫЕ ТУМАННОСТИ НА ФОНЕ */
        .nebula {
            position: absolute;
            width: 600px; height: 600px;
            background: radial-gradient(circle, rgba(0,240,255,0.08) 0%, transparent 60%);
            filter: blur(50px);
            z-index: 0;
            animation: drift 20s infinite alternate ease-in-out;
        }
        .nebula-1 { top: -10%; left: -10%; }
        .nebula-2 { bottom: -10%; right: -10%; background: radial-gradient(circle, rgba(138,43,226,0.08) 0%, transparent 60%); animation-delay: -10s; }

        @keyframes drift {
            0% { transform: translate(0, 0); }
            100% { transform: translate(50px, 50px); }
        }

        /* ЗВЕЗДЫ */
        .stars {
            position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            background-image: 
                radial-gradient(1px 1px at 10% 20%, #fff, transparent),
                radial-gradient(1.5px 1.5px at 80% 40%, #fff, transparent),
                radial-gradient(1px 1px at 40% 80%, #fff, transparent);
            background-size: 300px 300px;
            animation: twinkle 5s infinite alternate;
            z-index: 0; opacity: 0.6;
        }

        @keyframes twinkle { 0% { opacity: 0.4; } 100% { opacity: 0.8; } }

        /* ПРОФИЛЬ */
        .profile {
            position: absolute; top: 40px; left: 40px;
            display: flex; align-items: center; gap: 15px;
            background: var(--glass); backdrop-filter: blur(16px);
            border: 1px solid var(--glass-border);
            padding: 8px 24px 8px 8px; border-radius: 12px;
            z-index: 10; transition: 0.3s ease;
            cursor: pointer;
        }

        .profile:hover {
            border-color: var(--main-color);
            box-shadow: 0 0 20px rgba(0, 240, 255, 0.15);
        }

        .avatar {
            width: 42px; height: 42px; background: #1a233a;
            border-radius: 8px; border: 1px solid var(--main-color);
        }

        .nickname { font-weight: 500; font-size: 14px; letter-spacing: 1px; color: #e6f1ff; }

        /* НАСТРОЙКИ СВЕРХУ */
        .top-settings {
            position: absolute; top: 40px; right: 40px;
            display: flex; gap: 12px; z-index: 10;
        }

        .icon-btn {
            width: 42px; height: 42px; border-radius: 10px;
            background: var(--glass); backdrop-filter: blur(16px);
            border: 1px solid var(--glass-border);
            display: flex; justify-content: center; align-items: center;
            cursor: pointer; transition: 0.3s ease;
        }

        /* ИКОНКИ SVG */
        .icon-btn svg, .palette-btn svg { width: 20px; height: 20px; fill: var(--text-muted); transition: 0.3s ease; }

        .icon-btn:hover {
            border-color: var(--main-color);
            box-shadow: 0 0 15px rgba(0, 240, 255, 0.2);
        }
        .icon-btn:hover svg { fill: var(--main-color); }

        /* ЦЕНТР */
        .center-menu {
            z-index: 10; display: flex; flex-direction: column;
            align-items: center; gap: 25px;
        }

        .play-btn {
            background: rgba(0, 240, 255, 0.05);
            border: 1px solid var(--main-color);
            color: var(--main-color); font-family: 'Orbitron', sans-serif;
            font-size: 28px; font-weight: 700; letter-spacing: 8px;
            padding: 22px 90px; border-radius: 12px;
            cursor: pointer; position: relative;
            transition: all 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
            text-transform: uppercase;
            box-shadow: 0 0 15px rgba(0, 240, 255, 0.1), inset 0 0 15px rgba(0, 240, 255, 0.05);
        }

        /* Световой блик при наведении */
        .play-btn::before {
            content: ''; position: absolute; top: 0; left: -100%; width: 100%; height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
            transition: 0.5s;
        }

        .play-btn:hover::before { left: 100%; }

        .play-btn:hover {
            background: rgba(0, 240, 255, 0.15);
            box-shadow: 0 0 30px rgba(0, 240, 255, 0.4), inset 0 0 20px rgba(0, 240, 255, 0.2);
            transform: translateY(-2px);
            text-shadow: 0 0 10px var(--main-color);
        }

        .version-selector {
            background: var(--glass); backdrop-filter: blur(16px);
            border: 1px solid var(--glass-border);
            padding: 10px 30px; border-radius: 8px;
            font-size: 13px; color: var(--text-muted); cursor: pointer; transition: 0.3s;
            text-transform: uppercase; letter-spacing: 2px;
        }

        .version-selector:hover { border-color: var(--main-color); color: #fff; }

        /* ПАЛИТРА */
        .palette-btn {
            position: absolute; bottom: 40px; right: 40px;
            width: 50px; height: 50px; border-radius: 12px;
            background: var(--glass); backdrop-filter: blur(16px);
            border: 1px solid var(--glass-border);
            display: flex; justify-content: center; align-items: center;
            cursor: pointer; z-index: 10; transition: 0.4s ease;
        }

        .palette-btn:hover {
            border-color: var(--main-color);
            box-shadow: 0 0 20px rgba(0, 240, 255, 0.2);
        }
        .palette-btn:hover svg { fill: var(--main-color); transform: rotate(90deg); }

        /* ЦИТАТЫ */
        .quotes {
            position: absolute; width: 100%; height: 100%;
            pointer-events: none; z-index: 1;
        }
        
        .quote {
            position: absolute; font-size: 13px; letter-spacing: 1px;
            color: rgba(255,255,255,0.2); font-weight: 300; font-style: italic;
            animation: floatQuote 10s infinite linear; opacity: 0;
        }

        .q1 { top: 25%; left: 15%; animation-delay: 0s; }
        .q2 { top: 75%; left: 20%; animation-delay: 3s; }
        .q3 { top: 35%; right: 15%; animation-delay: 6s; }

        @keyframes floatQuote {
            0% { transform: translateY(0); opacity: 0; }
            20% { opacity: 0.6; }
            80% { opacity: 0.6; }
            100% { transform: translateY(60px); opacity: 0; }
        }
    </style>
</head>
<body>
    <div class="nebula nebula-1"></div>
    <div class="nebula nebula-2"></div>
    <div class="stars"></div>
    
    <div class="quotes">
        <div class="quote q1">«Дорогу осилит идущий»</div>
        <div class="quote q2">«Не бойся ошибок, бойся бездействия»</div>
        <div class="quote q3">«Лучшее время начать — сегодня»</div>
    </div>

    <div class="profile">
        <div class="avatar"></div>
        <div class="nickname">Мик версия</div>
    </div>

    <div class="top-settings">
        <div class="icon-btn">
            <svg viewBox="0 0 24 24"><path d="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.06-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61 l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41 h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.73,8.87 C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.06,0.94l-2.03,1.58 c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54 c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96 c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.49-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6 s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z"/></svg>
        </div>
        <div class="icon-btn">
            <svg viewBox="0 0 24 24"><path d="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"/></svg>
        </div>
        <div class="icon-btn">
            <svg viewBox="0 0 24 24"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg>
        </div>
    </div>

    <div class="center-menu">
        <button class="play-btn">Играть</button>
        <div class="version-selector">Выбрать / скачать версию</div>
    </div>

    <div class="palette-btn">
        <svg viewBox="0 0 24 24"><path d="M12 3c-4.97 0-9 4.03-9 9s4.03 9 9 9c.83 0 1.5-.67 1.5-1.5 0-.39-.15-.74-.39-1.01-.23-.26-.38-.61-.38-.99 0-.83.67-1.5 1.5-1.5H16c2.76 0 5-2.24 5-5 0-4.42-4.03-8-9-8zm-5.5 9c-.83 0-1.5-.67-1.5-1.5S5.67 9 6.5 9 8 9.67 8 10.5 7.33 12 6.5 12zm3-4C8.67 8 8 7.33 8 6.5S8.67 5 9.5 5s1.5.67 1.5 1.5S10.33 8 9.5 8zm5 0c-.83 0-1.5-.67-1.5-1.5S13.67 5 14.5 5s1.5.67 1.5 1.5S15.33 8 14.5 8zm3 4c-.83 0-1.5-.67-1.5-1.5S16.67 9 17.5 9s1.5.67 1.5 1.5-.67 1.5-1.5 1.5z"/></svg>
    </div>

</body>
</html>
