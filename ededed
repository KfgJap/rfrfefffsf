<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nebula Launcher</title>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --accent: #5e9eff;
            --accent-glow: rgba(94, 158, 255, 0.4);
            --bg: #020308;
            --panel: rgba(15, 22, 40, 0.5);
            --border: rgba(255, 255, 255, 0.1);
            --text: #f1f5f9;
            --text-dim: #8892b0;
            --smooth: cubic-bezier(0.16, 1, 0.3, 1);
        }

        * {
            margin: 0; padding: 0; box-sizing: border-box;
            font-family: 'Manrope', sans-serif;
            user-select: none;
            cursor: none; /* Кастомный курсор */
        }

        body {
            height: 100vh;
            background: var(--bg);
            overflow: hidden; color: var(--text);
        }

        /* --- КУРСОР --- */
        .cursor {
            position: fixed; width: 8px; height: 8px;
            background: var(--accent); border-radius: 50%;
            pointer-events: none; z-index: 9999;
            transform: translate(-50%, -50%);
            box-shadow: 0 0 15px var(--accent);
            transition: width 0.3s, height 0.3s, background 0.3s, border 0.3s;
        }
        .cursor.hovering {
            width: 28px; height: 28px; background: transparent;
            border: 2px solid var(--accent);
        }

        /* --- ФОН (Галактика и Звезды) --- */
        .bg-layer { position: absolute; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; }
        
        .galaxy {
            position: absolute; top: 50%; left: 50%;
            width: 150vw; height: 150vw;
            transform: translate(-50%, -50%) rotate(0deg);
            background: conic-gradient(from 0deg, transparent, var(--accent-glow), transparent, rgba(138, 43, 226, 0.15), transparent);
            border-radius: 50%; filter: blur(70px); opacity: 0.6;
            animation: rotateGalaxy 120s linear infinite;
        }
        @keyframes rotateGalaxy { 100% { transform: translate(-50%, -50%) rotate(360deg); } }

        .stars {
            position: absolute; inset: -50%;
            background-image: 
                radial-gradient(1.5px 1.5px at 20% 30%, #fff, transparent),
                radial-gradient(2px 2px at 70% 60%, #fff, transparent),
                radial-gradient(1px 1px at 40% 80%, #fff, transparent);
            background-size: 300px 300px; opacity: 0.8;
            animation: rotate 150s linear infinite;
        }
        @keyframes rotate { 100% { transform: rotate(5deg); } }

        .nebula {
            position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
            width: 80vw; height: 80vh;
            background: radial-gradient(circle, var(--accent-glow) 0%, transparent 60%);
            filter: blur(100px); opacity: 0.4;
        }

        /* --- СТЕКЛО --- */
        .glass {
            background: var(--panel); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
            border: 1px solid var(--border);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5), inset 0 1px 0 rgba(255,255,255,0.1);
            transition: all 0.4s var(--smooth);
        }
        .glass:hover {
            border-color: var(--accent); background: rgba(30, 45, 80, 0.6);
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.6), 0 0 25px var(--accent-glow);
        }

        /* --- ВЕРХНИЕ УГЛЫ --- */
        .profile {
            position: absolute; top: 40px; left: 40px; z-index: 10;
            display: flex; align-items: center; gap: 15px; padding: 10px 25px 10px 10px; border-radius: 50px; cursor: pointer;
        }
        .avatar { width: 40px; height: 40px; border-radius: 50%; background: #1e2433; border: 2px solid var(--accent); box-shadow: 0 0 15px var(--accent-glow); }
        .nickname { font-size: 15px; font-weight: 700; letter-spacing: 0.5px; }

        .top-actions { position: absolute; top: 40px; right: 40px; display: flex; gap: 12px; z-index: 10; }
        .icon-btn { width: 44px; height: 44px; border-radius: 14px; display: flex; justify-content: center; align-items: center; cursor: pointer; }
        .icon-btn svg { width: 20px; height: 20px; fill: var(--text-dim); transition: fill 0.3s; }
        .icon-btn:hover svg { fill: var(--accent); }

        /* --- СОЦСЕТИ (Слева внизу) --- */
        .socials { position: absolute; bottom: 40px; left: 40px; display: flex; flex-direction: column; gap: 12px; z-index: 10; }
        .social-btn { width: 44px; height: 44px; border-radius: 12px; display: flex; justify-content: center; align-items: center; cursor: pointer; }
        .social-btn svg { width: 20px; height: 20px; fill: var(--text-dim); transition: fill 0.3s; }
        .social-btn:hover svg { fill: #fff; }

        /* --- ЦЕНТР --- */
        .center-menu {
            position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
            display: flex; flex-direction: column; align-items: center; gap: 20px; z-index: 10;
        }
        .play-btn {
            background: linear-gradient(180deg, rgba(255,255,255,0.15) 0%, transparent 100%);
            border: 1.5px solid var(--accent); color: #fff; font-size: 26px; font-weight: 800; letter-spacing: 5px;
            padding: 20px 90px; border-radius: 16px; cursor: pointer; text-transform: uppercase;
            box-shadow: 0 0 30px var(--accent-glow), inset 0 1px 0 rgba(255,255,255,0.3);
            transition: all 0.4s var(--smooth);
        }
        .play-btn:hover { transform: scale(1.05); box-shadow: 0 0 60px var(--accent-glow); }
        .version-btn { font-size: 14px; font-weight: 600; color: var(--text-dim); background: none; border: none; cursor: pointer; transition: color 0.3s; }
        .version-btn:hover { color: var(--accent); }

        /* --- ПОЛЗУНОК --- */
        .slider-container {
            position: absolute; bottom: 40px; left: 50%; transform: translateX(-50%);
            display: flex; align-items: center; gap: 20px; padding: 12px 25px; border-radius: 40px; z-index: 10;
        }
        .slider-label { font-size: 12px; font-weight: 800; color: var(--text-dim); text-transform: uppercase; }
        .track { position: relative; width: 200px; height: 6px; background: rgba(255,255,255,0.1); border-radius: 3px; cursor: pointer; }
        .fill { position: absolute; top: 0; left: 0; height: 100%; background: var(--accent); border-radius: 3px; width: 50%; box-shadow: 0 0 10px var(--accent-glow); }
        .thumb { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 20px; height: 20px; background: #fff; border-radius: 50%; box-shadow: 0 0 15px var(--accent); pointer-events: none; }
        .marks { display: flex; gap: 15px; }
        .mark { font-size: 11px; font-weight: 700; color: var(--text-dim); }
        .mark.active { color: var(--accent); text-shadow: 0 0 10px var(--accent-glow); }

        /* --- ПАЛИТРА (Справа внизу) --- */
        .palette-btn {
            position: absolute; bottom: 40px; right: 40px; width: 54px; height: 54px; border-radius: 16px;
            display: flex; justify-content: center; align-items: center; cursor: pointer; z-index: 20;
        }
        .palette-btn svg { width: 24px; height: 24px; fill: var(--text-dim); transition: fill 0.3s; }
        .palette-btn:hover svg { fill: var(--accent); }

        /* Меню палитры */
        .palette-menu {
            position: absolute; bottom: 110px; right: 40px; width: 320px; padding: 20px; border-radius: 20px;
            display: flex; align-items: center; gap: 20px; z-index: 20;
            opacity: 0; pointer-events: none; transform: translateY(20px); transition: all 0.4s var(--smooth);
        }
        .palette-menu.open { opacity: 1; pointer-events: all; transform: translateY(0); }

        .color-wheel {
            position: relative; width: 90px; height: 90px; border-radius: 50%; flex-shrink: 0;
            background: conic-gradient(red, yellow, lime, aqua, blue, magenta, red);
            cursor: crosshair; border: 2px solid rgba(255,255,255,0.2);
        }
        .wheel-picker { position: absolute; width: 14px; height: 14px; border: 2px solid #fff; border-radius: 50%; transform: translate(-50%, -50%); pointer-events: none; box-shadow: 0 0 10px rgba(0,0,0,0.5); }
        
        .hex-box { display: flex; flex-direction: column; gap: 8px; flex: 1; }
        .hex-label { font-size: 11px; font-weight: 800; color: var(--text-dim); text-transform: uppercase; }
        .hex-input {
            width: 100%; height: 45px; border-radius: 12px; background: rgba(0,0,0,0.4); border: 1px solid var(--border);
            color: #fff; font-family: monospace; font-size: 16px; text-align: center; outline: none; transition: 0.3s;
        }
        .hex-input:focus { border-color: var(--accent); }
    </style>
</head>
<body>
    <!-- Кастомный курсор -->
    <div class="cursor" id="cursor"></div>

    <!-- Фон -->
    <div class="bg-layer">
        <div class="galaxy"></div>
        <div class="stars"></div>
        <div class="nebula"></div>
    </div>

    <!-- Профиль -->
    <div class="profile glass interactive">
        <div class="avatar"></div>
        <div class="nickname">Мик версия</div>
    </div>

    <!-- Настройки (Справа сверху) -->
    <div class="top-actions">
        <div class="icon-btn glass interactive"><svg viewBox="0 0 24 24"><path d="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.06-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61 l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41 h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.73,8.87 C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.06,0.94l-2.03,1.58 c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54 c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96 c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.49-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6 s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z"/></svg></div>
        <div class="icon-btn glass interactive"><svg viewBox="0 0 24 24"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg></div>
    </div>

    <!-- Соцсети (Слева внизу) -->
    <div class="socials">
        <div class="social-btn glass interactive"><svg viewBox="0 0 24 24"><path d="M19.27 5.33C17.94 4.71 16.5 4.26 15 4a.09.09 0 0 0-.07.03c-.18.33-.39.76-.53 1.09a16.09 16.09 0 0 0-4.8 0c-.14-.34-.35-.76-.54-1.09c-.01-.02-.04-.03-.07-.03c-1.5.26-2.93.71-4.27 1.33c-.01 0-.02.01-.03.02c-2.72 4.07-3.47 8.03-3.1 11.95c0 .02.01.04.03.05c1.8 1.32 3.53 2.12 5.24 2.65c.03.01.06 0 .07-.02c.4-.55.76-1.13 1.07-1.74c.02-.04 0-.08-.04-.09c-.57-.22-1.11-.48-1.64-.78c-.04-.02-.04-.08-.01-.11c.11-.08.22-.17.33-.25c.02-.02.05-.02.07-.01c3.44 1.57 7.15 1.57 10.55 0c.02-.01.05-.01.07.01c.11.09.22.17.33.26c.04.03.04.09-.01.11c-.52.31-1.07.56-1.64.78c-.04.01-.05.06-.04.09c.32.61.68 1.19 1.07 1.74c.03.01.06.02.09.01c1.72-.53 3.45-1.33 5.25-2.65c.02-.01.03-.03.03-.05c.44-4.53-.73-8.46-3.1-11.95c-.01-.01-.02-.02-.04-.02zM8.52 14.91c-1.03 0-1.89-.95-1.89-2.12s.84-2.12 1.89-2.12c1.06 0 1.9.96 1.89 2.12c0 1.17-.84 2.12-1.89 2.12zm6.97 0c-1.03 0-1.89-.95-1.89-2.12s.84-2.12 1.89-2.12c1.06 0 1.9.96 1.89 2.12c0 1.17-.83 2.12-1.89 2.12z"/></svg></div>
        <div class="social-btn glass interactive"><svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69.01-.03.01-.14-.07-.19-.08-.05-.19-.02-.27 0-.11.03-1.84 1.17-5.19 3.44-.49.34-.94.5-1.34.49-.44-.01-1.29-.25-1.92-.46-.78-.26-1.4-.4-1.35-.85.02-.23.35-.47.98-.72 3.85-1.68 6.42-2.78 7.71-3.32 3.66-1.52 4.42-1.79 4.91-1.8.11 0 .35.03.5.13.13.09.17.21.18.3.01.09.02.27.01.36z"/></svg></div>
    </div>

    <!-- Центр: Кнопка Играть и Версия -->
    <div class="center-menu">
        <button class="play-btn interactive">Играть</button>
        <button class="version-btn interactive">Выбрать версию</button>
    </div>

    <!-- Ползунок графики -->
    <div class="slider-container glass">
        <span class="slider-label">Графика</span>
        <div class="track interactive" id="track">
            <div class="fill" id="fill"></div>
            <div class="thumb" id="thumb"></div>
        </div>
        <div class="marks">
            <span class="mark" id="m0">Слабо</span>
            <span class="mark active" id="m1">Средне</span>
            <span class="mark" id="m2">Мощно</span>
        </div>
    </div>

    <!-- Палитра -->
    <div class="palette-btn glass interactive" id="paletteBtn">
        <svg viewBox="0 0 24 24"><path d="M12 3c-4.97 0-9 4.03-9 9s4.03 9 9 9c.83 0 1.5-.67 1.5-1.5 0-.39-.15-.74-.39-1.01-.23-.26-.38-.61-.38-.99 0-.83.67-1.5 1.5-1.5H16c2.76 0 5-2.24 5-5 0-4.42-4.03-8-9-8zm-5.5 9c-.83 0-1.5-.67-1.5-1.5S5.67 9 6.5 9 8 9.67 8 10.5 7.33 12 6.5 12zm3-4C8.67 8 8 7.33 8 6.5S8.67 5 9.5 5s1.5.67 1.5 1.5S10.33 8 9.5 8zm5 0c-.83 0-1.5-.67-1.5-1.5S13.67 5 14.5 5s1.5.67 1.5 1.5S15.33 8 14.5 8zm3 4c-.83 0-1.5-.67-1.5-1.5S16.67 9 17.5 9s1.5.67 1.5 1.5-.67 1.5-1.5 1.5z"/></svg>
    </div>

    <div class="palette-menu glass" id="paletteMenu">
        <div class="color-wheel interactive" id="wheel">
            <div class="wheel-picker" id="picker"></div>
        </div>
        <div class="hex-box">
            <div class="hex-label">HEX</div>
            <input type="text" class="hex-input interactive" id="hexInput" value="#5E9EFF" maxlength="7">
        </div>
    </div>

    <!-- СКРИПТЫ -->
    <script>
        // 1. КУРСОР
        const cursor = document.getElementById('cursor');
        const interactables = document.querySelectorAll('.interactive');
        document.addEventListener('mousemove', (e) => {
            cursor.style.left = e.clientX + 'px';
            cursor.style.top = e.clientY + 'px';
        });
        interactables.forEach(el => {
            el.addEventListener('mouseenter', () => cursor.classList.add('hovering'));
            el.addEventListener('mouseleave', () => cursor.classList.remove('hovering'));
        });

        // 2. ПАЛИТРА (ОТКРЫТИЕ)
        const paletteBtn = document.getElementById('paletteBtn');
        const paletteMenu = document.getElementById('paletteMenu');
        paletteBtn.addEventListener('click', () => {
            paletteMenu.classList.toggle('open');
        });

        // 3. ПАЛИТРА (ЦВЕТ)
        const wheel = document.getElementById('wheel');
        const picker = document.getElementById('picker');
        const hexInput = document.getElementById('hexInput');

        function updateTheme(hex) {
            document.documentElement.style.setProperty('--accent', hex);
            let r = parseInt(hex.slice(1,3), 16) || 0;
            let g = parseInt(hex.slice(3,5), 16) || 0;
            let b = parseInt(hex.slice(5,7), 16) || 0;
            document.documentElement.style.setProperty('--accent-glow', `rgba(${r}, ${g}, ${b}, 0.4)`);
            hexInput.value = hex.toUpperCase();
            picker.style.backgroundColor = hex;
        }

        // Выбор по клику
        wheel.addEventListener('click', (e) => {
            let rect = wheel.getBoundingClientRect();
            let x = e.clientX - rect.left - rect.width / 2;
            let y = e.clientY - rect.top - rect.height / 2;
            let angle = Math.atan2(y, x) * (180 / Math.PI) + 90;
            if (angle < 0) angle += 360;
            
            let hue = angle;
            // Формула перевода угла в цвет
            let hex = hslToHex(hue, 100, 60);
            updateTheme(hex);
            
            // Двигаем маркер
            let radius = rect.width / 2 - 8;
            picker.style.left = (Math.cos(angle * Math.PI / 180 - Math.PI / 2) * radius + rect.width / 2) + 'px';
            picker.style.top = (Math.sin(angle * Math.PI / 180 - Math.PI / 2) * radius + rect.height / 2) + 'px';
        });

        // Ввод HEX вручную
        hexInput.addEventListener('input', (e) => {
            let val = e.target.value;
            if (val.length === 7 && val.startsWith('#')) {
                updateTheme(val);
            }
        });

        function hslToHex(h, s, l) {
            l /= 100;
            const a = s * Math.min(l, 1 - l) / 100;
            const f = n => {
                const k = (n + h / 30) % 12;
                const color = l - a * Math.max(Math.min(k - 3, 9 - k, 1), -1);
                return Math.round(255 * color).toString(16).padStart(2, '0');
            };
            return `#${f(0)}${f(8)}${f(4)}`;
        }

        // 4. ПОЛЗУНОК (ИСПРАВЛЕННЫЙ)
        const track = document.getElementById('track');
        const fill = document.getElementById('fill');
        const thumb = document.getElementById('thumb');
        const marks = [document.getElementById('m0'), document.getElementById('m1'), document.getElementById('m2')];
        let isDragging = false;

        track.addEventListener('mousedown', (e) => {
            isDragging = true;
            moveThumb(e);
        });

        window.addEventListener('mousemove', (e) => {
            if (isDragging) moveThumb(e);
        });

        window.addEventListener('mouseup', () => {
            isDragging = false;
        });

        function moveThumb(e) {
            let rect = track.getBoundingClientRect();
            // Считаем позицию относительно самой полоски
            let x = Math.max(0, Math.min(100, ((e.clientX - rect.left) / rect.width) * 100));
            
            fill.style.width = x + '%';
            thumb.style.left = x + '%';

            // Активный маркер
            let idx = x < 33 ? 0 : x > 66 ? 2 : 1;
            marks.forEach((m, i) => m.classList.toggle('active', i === idx));
        }
    </script>
</body>
</html>
