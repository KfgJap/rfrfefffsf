<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <title>Space Launcher</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --accent: #5e9eff;
            --accent-glow: rgba(94, 158, 255, 0.5);
            --bg: #020308;
            --glass: rgba(15, 22, 40, 0.35);
            --glass-hover: rgba(30, 45, 80, 0.5);
            --border: rgba(255, 255, 255, 0.1);
            --border-hover: rgba(94, 158, 255, 0.8);
            --text: #e2e8f0;
            --text-dim: #8892b0;
            --smooth: cubic-bezier(0.16, 1, 0.3, 1);
        }

        * {
            margin: 0; padding: 0; box-sizing: border-box;
            font-family: 'Inter', sans-serif;
            user-select: none;
            cursor: none; /* СКРЫВАЕМ ОБЫЧНЫЙ КУРСОР */
        }

        body {
            height: 100vh;
            background: var(--bg);
            overflow: hidden; color: var(--text);
            display: flex; justify-content: center; align-items: center;
            position: relative;
        }

        /* КАСТОМНЫЙ КУРСОР-ПРИЦЕЛ */
        .cursor {
            position: fixed;
            width: 8px; height: 8px;
            background: var(--accent);
            border-radius: 50%;
            pointer-events: none;
            z-index: 9999;
            box-shadow: 0 0 10px var(--accent), 0 0 20px var(--accent);
            transform: translate(-50%, -50%);
            transition: width 0.2s, height 0.2s, background 0.2s;
        }

        /* ЖИВОЙ КОСМОС */
        .nebula {
            position: absolute;
            border-radius: 50%;
            filter: blur(100px);
            z-index: 0;
            opacity: 0.6;
            animation: drift 25s infinite alternate ease-in-out;
        }

        .nebula-1 { width: 70vw; height: 70vh; background: radial-gradient(circle, rgba(94, 158, 255, 0.15) 0%, transparent 70%); top: -20%; left: -20%; }
        .nebula-2 { width: 60vw; height: 60vh; background: radial-gradient(circle, rgba(138, 43, 226, 0.12) 0%, transparent 70%); bottom: -20%; right: -20%; animation-delay: -12s; animation-duration: 30s; }

        @keyframes drift {
            0% { transform: translate(0, 0) scale(1); }
            100% { transform: translate(150px, 100px) scale(1.2); }
        }

        .stars {
            position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            background-image: 
                radial-gradient(1.5px 1.5px at 20% 30%, rgba(255,255,255,0.8), transparent),
                radial-gradient(1px 1px at 70% 60%, rgba(255,255,255,0.6), transparent),
                radial-gradient(2px 2px at 40% 80%, rgba(255,255,255,0.4), transparent),
                radial-gradient(1px 1px at 80% 10%, rgba(255,255,255,0.7), transparent);
            background-size: 300px 300px;
            z-index: 1;
            animation: twinkle 5s infinite alternate;
        }

        @keyframes twinkle { 0% { opacity: 0.4; } 100% { opacity: 0.9; } }

        /* ПАДАЮЩИЕ КОМЕТЫ */
        .shooting-star {
            position: absolute;
            width: 100px; height: 2px;
            background: linear-gradient(90deg, rgba(255,255,255,0), #fff);
            opacity: 0;
            z-index: 2;
            animation: shoot 8s infinite;
        }
        .shooting-star:nth-child(1) { top: 10%; left: 10%; animation-delay: 2s; }
        .shooting-star:nth-child(2) { top: 40%; left: 60%; animation-delay: 6s; }

        @keyframes shoot {
            0% { transform: translateX(0) translateY(0) rotate(-45deg); opacity: 1; }
            10% { transform: translateX(-200px) translateY(200px) rotate(-45deg); opacity: 0; }
            100% { opacity: 0; }
        }

        /* СТЕКЛО */
        .glass-panel {
            background: var(--glass);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid var(--border);
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.4), inset 0 1px 0 rgba(255,255,255,0.1);
            transition: all 0.7s var(--smooth);
        }

        .glass-panel:hover {
            background: var(--glass-hover);
            border-color: var(--border-hover);
            box-shadow: 0 15px 40px 0 rgba(0, 0, 0, 0.6), 0 0 30px var(--accent-glow), inset 0 1px 0 rgba(255,255,255,0.3);
            transform: translateY(-4px) scale(1.02);
        }

        /* ПРОФИЛЬ */
        .profile { position: absolute; top: 32px; left: 32px; display: flex; align-items: center; gap: 12px; padding: 8px 20px 8px 8px; border-radius: 40px; z-index: 10; }
        .avatar { width: 36px; height: 36px; border-radius: 50%; background: #1e2433; border: 1px solid rgba(255,255,255,0.2); }
        .nickname { font-size: 14px; font-weight: 600; color: var(--text); }

        /* НАСТРОЙКИ */
        .top-actions { position: absolute; top: 32px; right: 32px; display: flex; gap: 12px; z-index: 10; }
        .action-btn { width: 44px; height: 44px; border-radius: 14px; display: flex; justify-content: center; align-items: center; }
        .action-btn svg { width: 20px; height: 20px; fill: var(--text-dim); transition: fill 0.4s ease; }
        .action-btn:hover svg { fill: var(--accent); }

        /* СОЦСЕТИ */
        .socials { position: absolute; bottom: 32px; left: 32px; display: flex; flex-direction: column; gap: 12px; z-index: 10; }
        .social-btn { width: 44px; height: 44px; border-radius: 14px; display: flex; justify-content: center; align-items: center; }
        .social-btn svg { width: 22px; height: 22px; fill: var(--text-dim); transition: all 0.4s ease; }
        .social-btn:hover svg { fill: #fff; transform: scale(1.1); }

        /* ЦЕНТР */
        .center { z-index: 10; display: flex; flex-direction: column; align-items: center; gap: 24px; }

        /* КНОПКА ИГРАТЬ С ПУЛЬСАЦИЕЙ */
        .play-btn {
            display: flex; align-items: center; justify-content: center; gap: 14px;
            background: linear-gradient(180deg, rgba(94, 158, 255, 0.35) 0%, rgba(94, 158, 255, 0.1) 100%);
            border: 1px solid rgba(94, 158, 255, 0.6);
            color: #fff; font-size: 18px; font-weight: 700; letter-spacing: 4px;
            padding: 22px 85px; border-radius: 20px;
            position: relative; overflow: hidden;
            backdrop-filter: blur(10px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.6), 0 0 40px rgba(94, 158, 255, 0.3), inset 0 1px 0 rgba(255,255,255,0.4);
            transition: all 0.7s var(--smooth);
            animation: pulseBtn 3s infinite alternate;
        }

        @keyframes pulseBtn {
            0% { box-shadow: 0 10px 30px rgba(0,0,0,0.6), 0 0 30px rgba(94, 158, 255, 0.2), inset 0 1px 0 rgba(255,255,255,0.4); }
            100% { box-shadow: 0 10px 30px rgba(0,0,0,0.6), 0 0 60px rgba(94, 158, 255, 0.5), inset 0 1px 0 rgba(255,255,255,0.6); }
        }

        .play-btn svg { width: 24px; height: 24px; fill: #fff; transition: transform 0.7s var(--smooth); }

        .play-btn::before {
            content: ''; position: absolute; top: 0; left: -100%; width: 50%; height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.4), transparent);
            transform: skewX(-20deg); transition: left 0.8s var(--smooth);
        }

        .play-btn:hover {
            background: linear-gradient(180deg, rgba(94, 158, 255, 0.6) 0%, rgba(94, 158, 255, 0.2) 100%);
            border-color: #fff; transform: translateY(-5px) scale(1.05);
            animation: none; /* Отключаем пульсацию при наведении, чтобы не мешала */
            box-shadow: 0 20px 50px rgba(0,0,0,0.8), 0 0 80px var(--accent-glow), inset 0 1px 0 rgba(255,255,255,0.8);
            text-shadow: 0 0 15px rgba(255,255,255,0.8);
        }

        .play-btn:hover::before { left: 150%; }
        .play-btn:hover svg { transform: scale(1.2); }

        .version { display: flex; align-items: center; gap: 8px; padding: 14px 32px; border-radius: 16px; font-size: 14px; font-weight: 500; color: var(--text-dim); }
        .version:hover { color: #fff; }

        /* СТАТУС */
        .status-panel { position: absolute; right: 32px; top: 50%; transform: translateY(-50%); display: flex; flex-direction: column; gap: 15px; padding: 24px; border-radius: 20px; z-index: 10; }
        .status-item { display: flex; align-items: center; gap: 12px; font-size: 14px; color: var(--text-dim); font-weight: 500; }
        .status-dot { width: 10px; height: 10px; border-radius: 50%; background: #10b981; box-shadow: 0 0 12px #10b981; }
        .status-dot.blue { background: var(--accent); box-shadow: 0 0 12px var(--accent); }

        /* ПАЛИТРА */
        .palette-btn { position: absolute; bottom: 32px; right: 32px; width: 54px; height: 54px; border-radius: 16px; display: flex; justify-content: center; align-items: center; z-index: 10; }
        .palette-btn svg { width: 26px; height: 26px; fill: var(--text-dim); transition: all 0.6s var(--smooth); }
        .palette-btn:hover { transform: translateY(-5px) rotate(15deg); }
        .palette-btn:hover svg { fill: var(--accent); }

        /* ЦИТАТЫ */
        .quotes { position: absolute; width: 100%; height: 100%; pointer-events: none; z-index: 2; }
        .quote { position: absolute; font-size: 14px; font-weight: 500; letter-spacing: 1px; color: rgba(255,255,255,0.25); text-shadow: 0 2px 10px rgba(0,0,0,0.8); animation: floatQuote 16s infinite linear; opacity: 0; }
        .q1 { top: 25%; left: 15%; animation-delay: 0s; }
        .q2 { top: 75%; left: 25%; animation-delay: 5.3s; }
        .q3 { top: 35%; right: 15%; animation-delay: 10.6s; }
        @keyframes floatQuote { 0% { transform: translateY(0); opacity: 0; } 15% { opacity: 1; } 85% { opacity: 1; } 100% { transform: translateY(60px); opacity: 0; } }
    </style>
</head>
<body>
    <!-- Курсор -->
    <div class="cursor" id="cursor"></div>

    <!-- Фон -->
    <div class="nebula nebula-1"></div>
    <div class="nebula nebula-2"></div>
    <div class="stars"></div>
    
    <!-- Кометы -->
    <div class="shooting-star"></div>
    <div class="shooting-star"></div>

