    <footer class="bottom-bar">
        <div class="slider-wrapper" id="sliderWrapper">
            <div class="slider-labels">
                <span class="label-item" id="mark0">Слабо</span>
                <span class="label-item active" id="mark1">Средне</span>
                <span class="label-item" id="mark2">Мощно</span>
            </div>
            <div class="slider-box glass">
                <span style="font-size: 12px; font-weight: 800; color: var(--text-dim); letter-spacing: 1px; text-transform: uppercase;">Графика</span>
                <div class="track interactive" id="sliderTrack">
                    <div class="fill" id="sliderFill"></div>
                    <div class="thumb" id="sliderThumb"></div>
                </div>
            </div>
        </div>
