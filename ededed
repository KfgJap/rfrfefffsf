const canvas = document.getElementById('gameCanvas');
const ctx = canvas.getContext('2d');
ctx.imageSmoothingEnabled = false;

const mainMenu = document.getElementById('mainMenu');
const gameUI = document.getElementById('gameUI');
const playBtn = document.getElementById('playBtn');
const backBtn = document.getElementById('backBtn');
const missionText = document.getElementById('missionText');

let gameRunning = false;
let missionComplete = false;

// Игрок (Призрак)
const player = { x: 0, y: 0, vx: 0, vy: 0, size: 16, speed: 6 };
const camera = { x: 0, y: 0 };
let targetX = 0, targetY = 0;
let isMoving = false;

// Окружение
let deadTrees = [];
let birds = [];
let grass = [];
let altar = { x: 1200, y: -800 };
let particles = [];

function resize() {
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
}
window.addEventListener('resize', resize);
resize();

// Генерация мира
function initWorld() {
    player.x = 0; player.y = 0; player.vx = 0; player.vy = 0;
    camera.x = 0; camera.y = 0;
    particles = [];
    missionComplete = false;
    missionText.innerText = "Find the Sacred Altar...";

    // Мертвая трава (пиксели на земле)
    grass = [];
    for(let i=0; i<3000; i++) {
        grass.push({
            x: (Math.random() - 0.5) * 4000,
            y: (Math.random() - 0.5) * 4000,
            size: Math.random() * 3 + 1,
            color: Math.random() > 0.8 ? '#1a1a1a' : '#0f0f0f'
        });
    }

    // Мертвые деревья
    deadTrees = [];
    for(let i=0; i<40; i++) {
        deadTrees.push({
            x: (Math.random() - 0.5) * 4000,
            y: (Math.random() - 0.5) * 4000,
            height: Math.random() * 60 + 30,
            width: Math.random() * 8 + 4
        });
    }

    // Вороны (летают)
    birds = [];
    for(let i=0; i<5; i++) {
        birds.push({
            x: Math.random() * 2000 - 1000,
            y: Math.random() * 1000 - 500,
            speedX: Math.random() * 2 - 1,
            speedY: Math.random() * 2 - 1,
            wingState: 0
        });
    }
}

playBtn.addEventListener('click', () => {
    mainMenu.style.display = 'none';
    gameUI.style.display = 'block';
    gameRunning = true;
    initWorld();
    requestAnimationFrame(update);
});

backBtn.addEventListener('click', () => {
    gameRunning = false;
    gameUI.style.display = 'none';
    mainMenu.style.display = 'flex';
});

window.addEventListener('mousedown', (e) => {
    if (!gameRunning || missionComplete) return;
    targetX = e.clientX - canvas.width / 2 + camera.x;
    targetY = e.clientY - canvas.height / 2 + camera.y;
    isMoving = true;
});

function update() {
    if (!gameRunning) return;

    // Движение
    if (isMoving) {
        let dx = targetX - player.x;
        let dy = targetY - player.y;
        let dist = Math.hypot(dx, dy);
        if (dist > 5) {
            player.x += (dx / dist) * player.speed;
            player.y += (dy / dist) * player.speed;
            
            // Пиксельный шлейф
            if (Math.random() > 0.5) {
                particles.push({ x: player.x, y: player.y + 5, life: 1.0, size: 4 });
            }
        } else {
            isMoving = false;
        }
    }

    camera.x += (player.x - camera.x) * 0.08;
    camera.y += (player.y - camera.y) * 0.08;

    particles.forEach((p, i) => {
        p.life -= 0.05;
        p.y += 1; // Падают вниз
        if (p.life <= 0) particles.splice(i, 1);
    });

    // Птицы летают
    birds.forEach(b => {
        b.x += b.speedX;
        b.y += b.speedY;
        b.wingState += 0.2;
        
        // Если улетела далеко - респавн
        if (b.x < player.x - 1000 || b.x > player.x + 1000) {
            b.x = player.x + (Math.random() > 0.5 ? 1200 : -1200);
            b.y = player.y + (Math.random() * 800 - 400);
        }
    });

    // Проверка финиша
    if (!missionComplete) {
        let distToAltar = Math.hypot(altar.x - player.x, altar.y - player.y);
        if (distToAltar < 100) {
            missionComplete = true;
            missionText.innerText = "The Altar awakens...";
        }
    }

    draw();
    requestAnimationFrame(update);
}

// Рисуем пиксельный прямоугольник
function drawPixelRect(x, y, w, h, color) {
    ctx.fillStyle = color;
    ctx.fillRect(Math.floor(x), Math.floor(y), Math.floor(w), Math.floor(h));
}

function draw() {
    // Фон (темная земля)
    ctx.fillStyle = '#050508';
    ctx.fillRect(0, 0, canvas.width, canvas.height);

    let cx = canvas.width / 2 - camera.x;
    let cy = canvas.height / 2 - camera.y;

    // Рисуем траву
    grass.forEach(g => {
        drawPixelRect(cx + g.x, cy + g.y, g.size, g.size, g.color);
    });

    // Рисуем Алтарь (Цель)
    let ax = cx + altar.x, ay = cy + altar.y;
    if (!missionComplete) {
        // Мертвый алтарь (темный)
        drawPixelRect(ax - 20, ay - 40, 40, 80, '#111');
        drawPixelRect(ax - 30, ay + 40, 60, 20, '#1a1a1a');
    } else {
        // Оживший алтарь (светится)
        ctx.shadowBlur = 40; ctx.shadowColor = '#4f8cff';
        drawPixelRect(ax - 20, ay - 40, 40, 80, '#4f8cff');
        drawPixelRect(ax - 30, ay + 40, 60, 20, '#a8b2d1');
        ctx.shadowBlur = 0;
    }

    // Рисуем деревья
    deadTrees.forEach(t => {
        drawPixelRect(cx + t.x, cy + t.y, t.width, -t.height, '#0a0a0a');
        // Ветки
        drawPixelRect(cx + t.x - 10, cy + t.y - t.height * 0.6, 10, 4, '#0a0a0a');
        drawPixelRect(cx + t.x + t.width, cy + t.y - t.height * 0.8, 15, 4, '#0a0a0a');
    });

    // Рисуем птиц (пиксельные вороны)
    birds.forEach(b => {
        let bx = cx + b.x, by = cy + b.y;
        let wingY = Math.sin(b.wingState) * 4;
        ctx.fillStyle = '#000';
        // Тело
        drawPixelRect(bx, by, 6, 4, '#000');
        // Крылья
        drawPixelRect(bx - 4, by + wingY, 4, 2, '#000');
        drawPixelRect(bx + 6, by + wingY, 4, 2, '#000');
    });

    // Шлейф
    particles.forEach(p => {
        drawPixelRect(cx + p.x, cy + p.y, p.size, p.size, `rgba(79, 140, 255, ${p.life})`);
    });

    // Игрок (Пиксельный Призрак)
    let px = cx + player.x, py = cy + player.y;
    
    // Тело (капля)
    ctx.shadowBlur = 20; ctx.shadowColor = '#fff';
    drawPixelRect(px - 8, py - 12, 16, 16, '#fff'); // Голова
    drawPixelRect(px - 6, py + 4, 12, 8, '#fff');   // Тело
    drawPixelRect(px - 8, py + 12, 4, 4, '#fff');   // Хвост 1
    drawPixelRect(px - 2, py + 12, 4, 4, '#fff');   // Хвост 2
    drawPixelRect(px + 4, py + 12, 4, 4, '#fff');   // Хвост 3
    ctx.shadowBlur = 0;

    // Глаза
    drawPixelRect(px - 4, py - 6, 2, 4, '#050508');
    drawPixelRect(px + 2, py - 6, 2, 4, '#050508');
}
