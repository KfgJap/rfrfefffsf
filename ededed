<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <title>Space Launcher</title>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;500;700&display=swap" rel="stylesheet">
    <style>
        /* БАЗОВЫЕ ПЕРЕМЕННЫЕ */
        :root {
            --main-color: #00f0ff; 
            --bg-dark: #03050a;
            --bg-light: #0a1128;
            --glass: rgba(255, 255, 255, 0.03);
            --glass-border: rgba(255, 255, 255, 0.08);
        }

        * {
            margin: 0; padding: 0; box-sizing: border-box;
            font-family: 'Montserrat', sans-serif;
            user-select: none;
        }

        body {
            height: 100vh;
            background: radial-gradient(circle at center, var(--bg-light) 0%, var(--bg-dark) 100%);
            overflow: hidden; color: white;
            display: flex; justify-content: center; align-items: center;
            position: relative;
        }

        /* ЗВЕЗДЫ */
        .stars {
            position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            background-image: 
                radial-gradient(1px 1px at 10% 20%, #fff, transparent),
                radial-gradient(1.5px 1.5px at 80% 40%, #fff, transparent),
                radial-gradient(2px 2px at 40% 80%, #fff, transparent),
                radial-gradient(1px 1px at 60% 10%, #fff, transparent);
            background-size: 200px 200px;
            animation: twinkle 4s infinite alternate;
            z-index: 0;
        }

        @keyframes twinkle { 0% { opacity: 0.3; } 100% { opacity: 0.8; } }

        /* ПРОФИЛЬ */
        .profile {
            position: absolute; top: 30px; left: 30px;
            display: flex; align-items: center; gap: 15px;
            background: var(--glass); backdrop-filter: blur(12px);
            border: 1px solid var(--glass-border);
            padding: 10px 20px 10px 10px; border-radius: 50px;
            z-index: 10; transition: 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
            cursor: pointer;
        }

        .profile:hover {
            border-color: var(--main-color);
            box-shadow: 0 0 15px rgba(0, 240, 255, 0.2);
            transform: translateY(-2px);
        }

        .avatar {
            width: 40px; height: 40px; background: #333;
            border-radius: 50%; border: 2px solid var(--main-color);
        }

        .nickname { font-weight: 500; letter-spacing: 1px; }

        /* НАСТРОЙКИ СВЕРХУ */
        .top-settings {
            position: absolute; top: 30px; right: 30px;
            display: flex; gap: 15px; z-index: 10;
        }

        .icon-btn {
            width: 45px; height: 45px; border-radius: 50%;
            background: var(--glass); backdrop-filter: blur(12px);
            border: 1px solid var(--glass-border);
            display: flex; justify-content: center; align-items: center;
            cursor: pointer; transition: 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
            font-size: 18px;
        }

        .icon-btn:hover {
            border-color: var(--main-color); color: var(--main-color);
            box-shadow: 0 0 20px rgba(0, 240, 255, 0.3);
            transform: translateY(-2px) scale(1.05);
        }

        /* ЦЕНТР */
        .center-menu {
            z-index: 10; display: flex; flex-direction: column;
            align-items: center; gap: 20px;
        }

        .play-btn {
            background: transparent; border: 2px solid var(--main-color);
            color: var(--main-color); font-size: 32px; font-weight: 700;
            letter-spacing: 5px; padding: 20px 80px; border-radius: 20px;
            cursor: pointer; position: relative; overflow: hidden;
            transition: 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
            text-transform: uppercase;
            box-shadow: 0 0 20px rgba(0, 240, 255, 0.1), inset 0 0 20px rgba(0, 240, 255, 0.1);
        }

        .play-btn:hover {
            background: var(--main-color); color: var(--bg-dark);
            box-shadow: 0 0 40px var(--main-color), 0 0 80px var(--main-color);
            transform: scale(1.05);
        }

        .version-selector {
            background: var(--glass); backdrop-filter: blur(12px);
            border: 1px solid var(--glass-border);
            padding: 12px 30px; border-radius: 50px;
            font-size: 14px; color: #ccc; cursor: pointer; transition: 0.4s;
        }

        .version-selector:hover { border-color: var(--main-color); color: white; }

        /* ПАЛИТРА */
        .palette-btn {
            position: absolute; bottom: 30px; right: 30px;
            width: 60px; height: 60px; border-radius: 50%;
            background: var(--glass); backdrop-filter: blur(12px);
            border: 1px solid var(--glass-border);
            display: flex; justify-content: center; align-items: center;
            font-size: 24px; cursor: pointer; z-index: 10;
            transition: 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
        }

        .palette-btn:hover {
            border-color: var(--main-color);
            box-shadow: 0 0 20px rgba(0, 240, 255, 0.3);
            transform: rotate(90deg) scale(1.1);
        }

        /* ЦИТАТЫ */
        .quotes {
            position: absolute; width: 100%; height: 100%;
            pointer-events: none; z-index: 1;
        }
        
        .quote {
            position: absolute; font-size: 14px;
            color: rgba(255,255,255,0.3); font-weight: 300; font-style: italic;
            animation: floatQuote 8s infinite linear; opacity: 0;
        }

        .q1 { top: 20%; left: 15%; animation-delay: 0s; }
        .q2 { top: 70%; left: 10%; animation-delay: 2s; }
        .q3 { top: 30%; right: 15%; animation-delay: 5s; }

        @keyframes floatQuote {
            0% { transform: translateY(0); opacity: 0; }
            20% { opacity: 1; }
            80% { opacity: 1; }
            100% { transform: translateY(60px); opacity: 0; }
        }
    </style>
</head>
<body>
    <div class="stars"></div>
    
    <div class="quotes">
        <div class="quote q1">«Дорогу осилит идущий»</div>
        <div class="quote q2">«Не бойся ошибок, бойся бездействия»</div>
        <div class="quote q3">«Лучшее время начать — сегодня»</div>
    </div>

    <div class="profile">
        <div class="avatar"></div>
        <div class="nickname">Мик версия</div>
    </div>

    <div class="top-settings">
        <div class="icon-btn">⚙️</div>
        <div class="icon-btn">📁</div>
        <div class="icon-btn">❌</div>
    </div>

    <div class="center-menu">
        <button class="play-btn">Играть</button>
        <div class="version-selector">Выбрать / скачать версию</div>
    </div>

    <div class="palette-btn">🎨</div>

</body>
</html>
